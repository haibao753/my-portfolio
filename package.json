{
  "name": "jh-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-legacy.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs --build-only",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "npm run check && npm run test:unit && npm run build && node scripts/verify-build.mjs",
    "test:unit": "node --test tests/*.test.mjs && playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "deploy:preview:dry-run": "wrangler deploy --config wrangler.preview.jsonc --dry-run"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.160.0",
    "wrangler": "^4.0.0"
  }
}
