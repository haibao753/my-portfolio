{
  "name": "jh-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-legacy.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "npm run check && node --test tests/build-guard.test.mjs && npm run build && node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "deploy:preview:dry-run": "wrangler deploy --config wrangler.preview.jsonc --dry-run"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "wrangler": "^4.0.0"
  }
}
