---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExplorationDesk from '../../components/ExplorationDesk.astro';
import OpticalUniverse from '../../components/OpticalUniverse.astro';
import {projects,contact} from '../../data/site';
---
<BaseLayout immersive title="胡金海的作品集 / Jinhai Hu — Math, Code & Images" description="胡金海的个人作品集：数学动画、交互几何实验、三维摄影空间与每日简报。看作品，也可以直接玩一个实验。">
 <OpticalUniverse />
 <ExplorationDesk />
 <section class="field-notes wrap" id="contact" aria-labelledby="field-notes-title">
  <header><p class="eyebrow">ABOUT & CONTACT</p><h2 id="field-notes-title"><span data-locale="zh">想聊点什么？<br/><em>联系我。</em></span><span data-locale="en">Have something in mind?<br/><em>Let's talk.</em></span></h2></header>
  <div class="notes-copy"><p><span data-locale="zh">这里住着一个好奇心有点过剩的大学生。<br/>在数学、代码和影像之间，寻找一些新的可能。</span><span data-locale="en">A university student with a little too much curiosity.<br/>Finding new possibilities between mathematics, code and images.</span></p><p class="notes-invitation"><span data-locale="zh">如果你也有个还没被定义的点子，我们聊聊。</span><span data-locale="en">If your idea doesn't have a name yet, let's talk.</span></p><a href={`mailto:${contact.email}`}>{contact.email} ↗</a><div class="wechat-line"><span>WECHAT / {contact.wechat}</span><button type="button" data-copy-wechat={contact.wechat} data-copied="false" aria-label="复制微信号"><span data-locale="zh">复制</span><span data-locale="en">Copy</span></button></div></div>
 </section>
 <nav class="all-paths wrap" aria-label="All exploration routes"><span class="eyebrow"><span data-locale="zh">保持好奇，保持联结。</span><span data-locale="en">STAY CURIOUS. STAY CONNECTED.</span></span>{projects.map(p=><a href={p.href} target={p.href.startsWith('http')?'_blank':undefined} rel={p.href.startsWith('http')?'noopener noreferrer':undefined}><span data-locale="zh">{p.action.zh}</span><span data-locale="en">{p.action.en}</span> ↗</a>)}<a href="/lab/glass/"><span data-locale="zh">玻璃研究</span><span data-locale="en">Glass studies</span> ↗</a><a href="/"><span data-locale="zh">当前主站</span><span data-locale="en">Current homepage</span> ↗</a></nav>
</BaseLayout>
<style>
 :global(.immersive-world .glass-nav){position:absolute;top:22px;left:4%;right:4%;margin:0;border:0;border-radius:0;background:none;box-shadow:none;backdrop-filter:none;color:#f2f2eb;--fg:#f2f2eb;--stroke:#ffffff30;--card:#ffffff0c}
 :global(.immersive-world .glass-nav::before),:global(.immersive-world .glass-nav::after),:global(.immersive-world .native-optic-edge){display:none!important}:global(.immersive-world .glass-nav .nav-inner){width:100%;min-height:50px}:global(.immersive-world .desktop-links a){font-size:11px;font-weight:400;opacity:.62}:global(.immersive-world .brand span){width:35px;height:35px}:global(.immersive-world .controls button){border-color:#ffffff20;height:40px;min-width:40px}:global(.immersive-world .controls [data-language-toggle]){font-size:11px;min-width:44px}:global(.immersive-world .mobile-menu){background:#151923e8;color:#f0f0ef;--fg:#f0f0ef;--muted:#b5bdcc;--stroke:#ffffff22}
 :global(.immersive-world .wrap){width:min(1360px,calc(100% - 12%))}:global(.immersive-world .site-footer){font:9px ui-monospace,monospace;padding-top:25px;padding-bottom:30px}
 .field-notes h2 em{font-family:Georgia,'Songti SC',serif;font-weight:400;font-style:italic;color:var(--accent)}
 .field-notes{display:grid;grid-template-columns:1fr 1.2fr;gap:60px;padding:115px 0 70px}.field-notes header .eyebrow{font:10px ui-monospace,monospace;letter-spacing:.12em}.field-notes h2{font-size:clamp(25px,3vw,42px);letter-spacing:-.065em;line-height:1.4;font-weight:600;margin-top:19px}.notes-copy{font-size:14px;line-height:2;color:var(--muted)}.notes-copy p{margin-bottom:15px}.notes-copy a{color:var(--fg);font-weight:600;display:inline-flex;align-items:center;min-height:44px}.notes-invitation{font-size:12px}.wechat-line{display:flex;align-items:center;gap:13px;font:10px ui-monospace,monospace;margin-top:5px}.wechat-line button{min-height:44px;padding:6px 10px;border:0;background:none;color:var(--muted);font-size:11px}.wechat-line button[data-copied="true"]{color:var(--accent)}.all-paths{display:flex;flex-wrap:wrap;align-items:center;gap:10px 23px;border-top:1px solid var(--stroke);padding-block:25px 55px}.all-paths .eyebrow{width:100%;margin-bottom:5px;font-size:10px}.all-paths a{font-size:11px;color:var(--muted);min-height:44px;display:inline-flex;align-items:center}.all-paths a:hover{color:var(--accent)}@media(max-width:760px){.field-notes{padding-top:62px;grid-template-columns:1fr;gap:10px;padding-bottom:30px}.field-notes h2{font-size:29px}.notes-copy{font-size:13px}.all-paths{gap:0 19px;padding-bottom:30px}}
</style>
