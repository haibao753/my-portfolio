---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="全球资讯观察站 — J.H. LAB" description="每天以中文整理全球议题、人工智能与前沿科学资讯，保留可信的原始来源。">
 <section class="brief-hero wrap" id="top" aria-labelledby="brief-heading">
  <div class="brief-masthead">
   <div><p class="eyebrow"><span data-locale="zh">J.H. LAB / 每日发现</span><span data-locale="en">J.H. LAB / DAILY DISCOVERIES</span></p>
    <h1 id="brief-heading"><span data-locale="zh">今日值得读</span><span data-locale="en">Worth Reading Today</span></h1>
   </div>
   <div class="issue-summary" aria-label="当前简报">
    <strong id="headlineDate">—</strong><small id="total" aria-live="polite">—</small>
   </div>
  </div>
 </section>
 <section class="news wrap" id="issues-section" aria-labelledby="archive-heading">
  <div class="news-heading">
   <div><h2 id="archive-heading"><span data-locale="zh">全球精选</span><span data-locale="en">Global Highlights</span></h2></div>
   <p><span data-locale="zh">从事实出发，寻找理解事件的线索。按主题筛选，或者回看之前的期数。</span><span data-locale="en">Explore each day's selected stories by topic or date.</span></p>
  </div>
  <div class="explore-bar" id="spatial-experiment" hidden><button id="spatial-open" type="button" aria-haspopup="dialog">◈ <span data-locale="zh">探索空间</span><span data-locale="en">Explore in 3D</span> ↗</button></div>
  <div class="toolbar">
   <div class="filters" id="tabs" role="group" aria-label="内容分类"></div>
   <div class="date-controls" aria-label="日期范围筛选">
    <div class="quick-dates" id="quick-dates" role="group" aria-label="快捷日期范围">
     <button type="button" data-days="3" aria-pressed="false"><span data-locale="zh">近三天</span><span data-locale="en">Last 3 days</span></button>
     <button type="button" data-days="7" aria-pressed="false"><span data-locale="zh">近一周</span><span data-locale="en">Last 7 days</span></button>
    </div>
    <label class="date-picker"><span data-locale="zh">日期 / 期数</span><span data-locale="en">ISSUE DATE</span><select id="issues" aria-label="选择历史日期"></select></label>
   </div>
  </div>
  <p class="status" id="status" role="status" aria-live="polite"><span data-locale="zh">正在载入每日简报…</span><span data-locale="en">Loading Daily Brief…</span></p>
  <div id="stories" class="stories" aria-live="off"></div>
  <dialog id="spatial-dialog" aria-labelledby="spatial-heading" aria-describedby="spatial-state"><div class="spatial-shell"><header><h2 id="spatial-heading"><span data-locale="zh">知识空间</span><span data-locale="en">Knowledge Space</span></h2><button id="spatial-close" type="button" aria-label="关闭探索空间">×</button></header><p id="spatial-state" role="status">选择一个节点展开阅读</p><div class="spatial-viewport" aria-label="可拖动的三维知识网络"></div><div id="spatial-scene" class="spatial-scene" aria-label="所选新闻详情"></div><footer><button type="button" data-rotate="-24" aria-label="向左旋转">←</button><span>拖动背景旋转 · 点击节点阅读</span><button type="button" data-rotate="24" aria-label="向右旋转">→</button></footer></div></dialog>
  <noscript><p>启用 JavaScript 以浏览与筛选每日简报。 / Enable JavaScript to browse and filter Daily Brief.</p></noscript>
  <p class="disclaimer"><span data-locale="zh">简报以 AI 辅助整理公开资讯，仅供信息参考，并非独立事实核查。重要结论请核对原始来源。</span><span data-locale="en">AI-assisted editorial summaries, not independent fact-checking. Verify important claims against original sources.</span></p>
 </section>
</BaseLayout>
<link rel="stylesheet" href="/assets/nav-orb.css?v=5" />
<script is:inline src="/assets/nav-orb.js?v=3" defer></script>
<script>
 import "../../lib/brief-reader";
 import "../../lib/spatial-reader";
</script>
<style>
 .brief-hero{padding-top:clamp(54px,8vw,114px);padding-bottom:clamp(40px,6vw,78px)}
 .brief-hero>h1{font-weight:750;letter-spacing:-.078em;line-height:1.13;font-size:clamp(57px,9.2vw,128px);text-align:center;margin:26px 0 clamp(40px,6vw,75px)}
 .brief-hero>.eyebrow{text-align:center}
 .hero-panel{display:grid;grid-template-columns:1.6fr .8fr;gap:clamp(22px,5vw,80px);align-items:center;background:var(--card);border:1px solid var(--stroke);border-radius:var(--radius);box-shadow:var(--shadow-md);padding:clamp(24px,4vw,55px)}
 .hero-panel>p{max-width:680px;font-size:clamp(14px,1.45vw,18px);line-height:1.95;color:var(--muted);margin:0}
 .hero-panel>p strong{display:block;color:var(--fg);font-weight:660;margin-bottom:8px}
 .issue-summary{border-left:1px solid var(--stroke);padding-left:28px;display:flex;flex-direction:column;gap:9px}
 .issue-summary strong{font-size:clamp(25px,3vw,36px);line-height:1.2;letter-spacing:-.045em}
 .issue-summary small{color:var(--muted)}
 .live-dot{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:9px}
 .hero-foot{display:flex;justify-content:space-between;gap:20px;margin-top:23px;color:var(--muted);font-size:12px}
 .news{padding-block:clamp(60px,7vw,105px) 135px}
 .news-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:38px}
 .news-heading h2{font-size:clamp(36px,5vw,69px);line-height:1.18;letter-spacing:-.06em;margin:14px 0 0}
 .news-heading>p{max-width:350px;color:var(--muted);line-height:1.9;font-size:14px}
 .toolbar{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1px solid var(--fg);border-bottom:1px solid var(--stroke);padding:18px 0}
 .filters{display:flex;flex-wrap:wrap;gap:8px}
 :global(.filter-chip){border:1px solid var(--stroke);background:transparent;color:var(--muted);padding:10px 15px;min-height:42px;border-radius:99px;font-size:13px}
 :global(.filter-chip[aria-pressed="true"]){background:var(--fg);color:var(--bg);border-color:var(--fg)}
 .date-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;max-width:100%}
 .quick-dates{display:flex;align-items:center;gap:7px}
 .quick-dates button{border:1px solid var(--stroke);background:var(--card);color:var(--muted);border-radius:999px;min-height:42px;padding:8px 13px;font-size:12px;font-weight:650;cursor:pointer;white-space:nowrap}
 .quick-dates button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
 .quick-dates button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
 .date-picker{display:flex;align-items:center;gap:13px;font-size:12px;color:var(--muted)}
 .date-picker select{background:var(--card);color:var(--fg);border:1px solid var(--stroke);border-radius:13px;min-height:43px;padding:8px 12px;font:inherit}
 .status{font-size:12px;color:var(--muted);margin:25px 0}
 .stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,27px)}
 :global(.news-card){min-width:0;display:flex;flex-direction:column;padding:clamp(20px,2.5vw,32px);border:1px solid var(--stroke);border-radius:22px;background:var(--card);box-shadow:var(--shadow-sm)}
 :global(.news-meta){display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--muted)}
 :global(.news-category){color:var(--accent);font-weight:650}
 :global(.news-card h3){font-size:clamp(19px,2.1vw,27px);line-height:1.45;letter-spacing:-.035em;margin:19px 0 13px}
 :global(.news-card p){font-size:13px;line-height:1.9;color:var(--muted);margin:0 0 13px}
 :global(.news-card .news-reason){border-top:1px solid var(--stroke);padding-top:13px;margin-top:auto}
 :global(.news-card .news-reason b){color:var(--fg)}
 :global(.news-source){border-top:1px solid var(--stroke);padding-top:16px;margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
 :global(.news-source a){color:var(--accent);font-weight:650}
 :global(.news-empty){grid-column:1/-1;text-align:center;padding:65px 20px;color:var(--muted)}
 :global(.news-expanded){margin-top:14px;border-top:1px solid var(--stroke);padding-top:14px;}
 :global(.news-expanded summary){cursor:pointer;display:list-item;color:var(--accent);font-weight:700;font-size:13px;line-height:1.8;padding:7px 0;outline-offset:4px}
 :global(.news-expanded[open] summary){margin-bottom:12px}
 :global(.news-expanded h4){font-size:14px;margin:18px 0 8px;font-weight:700}
 :global(.news-expanded .news-original-title){overflow-wrap:anywhere;color:var(--fg);font-size:13px}
 :global(.news-expanded .news-disclosure-note){margin-top:16px;font-size:12px;color:var(--muted);opacity:.85}
 .disclaimer{max-width:800px;color:var(--muted);font-size:12px;line-height:1.9;margin:55px 0 0}
 @media(max-width:980px){.stories{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:760px){.date-controls{width:100%;justify-content:space-between}.date-picker{flex-wrap:wrap}.hero-panel{grid-template-columns:1fr;gap:22px}.issue-summary{border-left:0;border-top:1px solid var(--stroke);padding:22px 0 0}.news-heading{display:block}.news-heading>p{margin-top:18px}.stories{grid-template-columns:1fr}.news{padding-bottom:95px}}

 /* The Astro route is the production page: a compact masthead puts news first. */
 .brief-hero{padding-top:14px;padding-bottom:14px;border-bottom:1px solid var(--stroke)}
 .brief-masthead{display:flex;justify-content:space-between;align-items:center;gap:20px}
 .brief-hero .eyebrow{margin:0 0 4px;text-align:left}
 .brief-hero h1{font-size:clamp(24px,3.4vw,40px);line-height:1.2;letter-spacing:-.055em;margin:0;text-align:left;font-weight:750}
 .issue-summary{border-left:0;padding:0;gap:2px;align-items:flex-end;flex-shrink:0}
 .issue-summary strong{font-size:14px;line-height:1.3}.issue-summary small{font-size:11px}
 .news{padding-top:16px}.news-heading{margin:0 0 8px}.news-heading h2{font-size:clamp(18px,2.6vw,28px);margin:0}
 .news-heading>p{display:none}.toolbar{padding:8px 0}.status{margin:10px 0;font-size:11px}
 @media(max-width:760px){.brief-hero{padding-top:12px;padding-bottom:12px}.brief-hero h1{font-size:25px}.brief-hero .eyebrow{font-size:10px}.issue-summary strong{font-size:12px}.issue-summary small{font-size:10px}.news{padding-top:11px}.news-heading{margin-bottom:7px}.news-heading h2{font-size:19px}.date-controls{width:auto;justify-content:flex-start}.quick-dates{display:flex}.date-picker{gap:5px}.date-picker>span{display:none}.date-picker select{min-height:35px;padding:5px 8px;font-size:11px}.toolbar{gap:7px;flex-direction:column;align-items:flex-start}.filters{gap:6px;max-height:38px;overflow:auto;flex-wrap:nowrap;width:100%;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}:global(.filter-chip){min-height:33px;padding:6px 11px;white-space:nowrap;font-size:11px}.stories{gap:12px}:global(.news-card){padding:18px}:global(.news-card h3){margin:10px 0 9px;font-size:21px}}

 /* Editorial flow: wider content, restrained chrome, progressively revealed details. */
 .brief-hero.wrap,.news.wrap{width:min(1560px,calc(100% - 48px));max-width:none}
 .news-heading{display:none}
 .news{padding-top:8px}
 .toolbar{border-top:0;border-bottom:1px solid var(--stroke)}
 .stories{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 30px}
 :global(.news-card){border:0;border-top:1px solid var(--stroke);box-shadow:none;border-radius:0;background:transparent;padding:26px 3px 35px;transition:background-color .3s ease,opacity .3s ease}
 :global(.news-card h3){font-size:clamp(23px,2.4vw,35px);margin:13px 0 13px;line-height:1.35}
 :global(.news-card .news-summary){font-size:clamp(14px,1.1vw,16px);line-height:1.88;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px}
 :global(.news-card .news-reason),:global(.news-card .news-expanded){display:none}
 :global(.news-card.is-reading .news-summary){display:block;overflow:visible}
 :global(.news-card.is-reading .news-reason){display:block}
 :global(.news-card.is-reading .news-expanded){display:block}
 :global(.news-read-toggle){align-self:flex-start;border:0;background:none;color:var(--accent);font:inherit;font-size:12px;padding:8px 0;cursor:pointer}
 :global(.news-read-toggle:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
 :global(.news-source){margin-top:8px;border:0;padding:8px 0 0}
 .disclaimer{margin-top:32px;border-top:1px solid var(--stroke);padding-top:18px;font-size:11px;opacity:.75}
 @media(max-width:760px){
  .brief-hero.wrap,.news.wrap{width:calc(100% - 28px)}
  .brief-hero{padding-block:8px}
  .news{padding-top:4px;padding-bottom:70px}
  .stories{grid-template-columns:minmax(0,1fr);gap:0}
  :global(.news-card){padding:21px 2px 27px;min-width:0}
  :global(.news-card h3){font-size:clamp(23px,6vw,29px);line-height:1.36}
  :global(.news-card .news-summary){font-size:15px;-webkit-line-clamp:2}
  .status{margin:7px 0;font-size:10px}
  .toolbar{padding:6px 0}
  .date-controls{align-self:flex-end}
 }
 @media(prefers-reduced-motion:reduce){:global(.news-card){transition:none}}


 .explore-bar[hidden]{display:none!important}
 .explore-bar{display:flex;justify-content:flex-end;padding:0 0 3px}
 .explore-bar button{cursor:pointer;border:0;background:transparent;color:var(--fg);font:inherit;font-size:12px;min-height:36px;padding:5px 2px}
 .explore-bar button:hover{text-decoration:underline;text-underline-offset:5px}
 #spatial-dialog{padding:0;border:1px solid var(--stroke);border-radius:24px;background:var(--bg);color:var(--fg);width:min(96vw,1040px);max-height:92dvh;box-shadow:0 24px 90px #0005}
 #spatial-dialog::backdrop{background:#070a13b8;backdrop-filter:blur(8px)}
 .spatial-shell{padding:clamp(12px,3vw,28px)}
 .spatial-shell header,.spatial-shell footer{display:flex;align-items:center;justify-content:space-between;gap:10px}
 .spatial-shell header h2{margin:0;font-size:clamp(20px,3vw,30px)}
 .spatial-shell header button,.spatial-shell footer button{background:transparent;color:var(--fg);border:1px solid var(--stroke);border-radius:999px;min-width:44px;min-height:44px;cursor:pointer;font-size:23px}
 #spatial-state{font-size:12px;color:var(--muted);margin:5px 0 10px}
 .spatial-viewport{height:min(57dvh,480px);min-height:280px;perspective:850px;overflow:hidden;display:grid;place-items:center;touch-action:pan-y;background:radial-gradient(ellipse at 50% 60%,color-mix(in srgb,var(--accent),transparent 91%),transparent 68%)}
 .spatial-scene{position:relative;width:0;height:0;transform-style:preserve-3d;transition:transform .48s cubic-bezier(.2,.7,.2,1)}
 .spatial-node{position:absolute;left:0;top:0;box-sizing:border-box;width:clamp(138px,21vw,215px);min-height:86px;padding:14px;transform:translate3d(calc(var(--x) - 50%),calc(var(--y) - 50%),var(--z));border:1px solid var(--stroke);border-radius:14px;background:var(--card);color:var(--fg);text-align:left;box-shadow:0 10px 30px #0002;cursor:pointer;backface-visibility:visible}
 .spatial-node:hover,.spatial-node:focus-visible{border-color:var(--accent);outline:2px solid var(--accent);outline-offset:2px}
 .spatial-label{display:block;color:var(--accent);font-size:10px;margin-bottom:7px}.spatial-node strong{font-size:13px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
 .spatial-shell footer{color:var(--muted);font-size:11px}
 @media(max-width:760px){.spatial-viewport{min-height:320px;height:52dvh;perspective:950px}.spatial-node{width:145px;font-size:12px}.spatial-shell footer span{font-size:10px;text-align:center}}
 @media(prefers-reduced-motion:reduce){.spatial-scene{transition:none}.spatial-viewport{perspective:none}}


 /* Native WebGL graph with independent readable HTML inspector. */
 .spatial-viewport{position:relative;height:min(52dvh,440px);min-height:310px;overflow:hidden;display:block;touch-action:none;perspective:none}
 .spatial-webgl{display:block;width:100%;height:100%;touch-action:none}
 .spatial-scene{position:absolute;left:12px;right:12px;bottom:12px;width:auto;height:auto;transform:none!important;pointer-events:auto;display:flex;flex-direction:column;gap:7px;align-items:flex-start;padding:15px;background:var(--card);border:1px solid var(--stroke);border-radius:14px;box-shadow:0 8px 28px #0001}
 .spatial-scene strong{font-size:clamp(15px,2vw,21px);line-height:1.4;max-width:100%;overflow-wrap:anywhere}
 .spatial-open-article{border:0;border-bottom:1px solid var(--fg);background:transparent;color:var(--fg);font:inherit;font-size:12px;min-height:32px;cursor:pointer;padding:4px 0}
 .spatial-scene .spatial-label{margin:0}
 @media(max-width:760px){.spatial-viewport{height:52dvh;min-height:320px}.spatial-scene{left:8px;right:8px;bottom:8px;padding:12px}.spatial-scene strong{font-size:17px}}


/* Fixed architecture: visualization and inspector occupy separate grid rows. */
.spatial-shell{display:flex;flex-direction:column;max-height:90dvh;min-height:0}
.spatial-viewport{height:clamp(220px,42dvh,440px);min-height:0;flex-shrink:1;border-radius:14px}
.spatial-scene{position:relative;inset:auto;width:100%;height:auto;max-height:23dvh;overflow:auto;flex-shrink:0;box-sizing:border-box;margin-top:8px;pointer-events:auto;box-shadow:none;border-radius:12px;padding:12px 14px;gap:5px}
.spatial-scene strong{font-size:clamp(14px,2vw,19px);line-height:1.35}
.spatial-shell footer{flex-shrink:0;margin-top:8px}
@media(max-width:760px){.spatial-shell{max-height:88dvh}.spatial-viewport{height:clamp(210px,37dvh,390px);min-height:0}.spatial-scene{position:relative;inset:auto;width:100%;max-height:20dvh;margin-top:7px;padding:10px 12px}.spatial-scene strong{font-size:15px}.spatial-shell footer{margin-top:6px}}
</style>
