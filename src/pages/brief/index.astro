 }
 .brief-filter-details::before{inset:0;z-index:0;background:radial-gradient(ellipse 76% 33% at 34% 0%,rgba(255,255,255,.38),transparent 93%),linear-gradient(126deg,rgba(255,255,255,.11),transparent 49%)}
