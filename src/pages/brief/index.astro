 .compact-chip{min-height:35px;max-width:130px;padding:7px 11px;border:0;border-radius:999px;background:transparent;color:var(--muted);font-size:12px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
