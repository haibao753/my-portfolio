---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
// Warm the two requests the reader needs first: the archive manifest and the
// newest issue. Data is committed before the Cloudflare build, so this stays
// in sync with the published JSON without changing the publishing pipeline.
let latestIssue = "";
try {
 const manifest = JSON.parse(readFileSync(join(process.cwd(), "brief/data/index.json"), "utf8"));
 const candidate = Array.isArray(manifest?.dates) ? manifest.dates[0] : "";
 if (typeof candidate === "string" && /^\d{4}-\d{2}-\d{2}$/.test(candidate)) latestIssue = candidate;
} catch {
 latestIssue = "";
}
---
<BaseLayout title="全球资讯观察站 — J.H. LAB" description="每天以中文整理全球议题、人工智能与前沿科学资讯，保留可信的原始来源。">
 <Fragment slot="head">
  <link rel="preload" href="/brief/data/index.json" as="fetch" />
  {latestIssue && <link rel="preload" href={`/brief/data/${latestIssue}.json`} as="fetch" />}
 </Fragment>
 <section class="brief-hero wrap" id="top" aria-labelledby="brief-heading">
  <div class="brief-masthead">
   <h1 id="brief-heading"><span data-locale="zh">今日值得读</span><span data-locale="en">Worth Reading Today</span></h1>
   <div class="brief-filter" id="brief-filter" data-expanded="false" aria-label="简报筛选">
    <span id="headlineDate" class="brief-visually-hidden" aria-live="off"></span>
    <div class="brief-filter-bar">
     <button type="button" id="filter-date" class="compact-date" aria-controls="filter-details" aria-expanded="false" aria-label="打开日期与筛选选项">
      <span id="filter-date-value" aria-hidden="true">-- --</span>
     </button>
     <button type="button" id="compact-category" class="compact-chip is-current" aria-controls="filter-details" aria-label="展开分类筛选">全部</button>
     <button type="button" id="compact-range" class="compact-chip" aria-controls="filter-details" aria-label="展开时间范围筛选">当天</button>
     <button type="button" id="compact-edition" class="compact-chip" aria-controls="filter-details" aria-label="展开刊期筛选">全部刊期</button>
     <span class="brief-count" aria-live="polite" aria-atomic="true"><span id="total">—</span><span class="brief-count-suffix" data-locale="zh"> 条精选</span><span class="brief-count-suffix" data-locale="en"> selected</span></span>
     <button type="button" class="brief-filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filter-details" aria-label="展开筛选栏">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
     </button>
    </div>
    <div class="brief-filter-details" id="filter-details" inert aria-hidden="true">
     <div class="filter-panel-head">
      <span class="filter-panel-caption"><span data-locale="zh">筛选资讯</span><span data-locale="en">Refine reading</span></span>
      <span class="filter-panel-actions"><span class="filter-expanded-meta" aria-live="polite" aria-atomic="true"><span id="expanded-total">—</span><span data-locale="zh"> 条精选</span><span data-locale="en"> selected</span></span><button type="button" id="filter-reset" class="filter-reset"><span data-locale="zh">重置</span><span data-locale="en">Reset</span></button></span>
     </div>
     <div class="filter-search" role="search" aria-label="搜索简报内容">
      <label class="filter-group-label" for="brief-search"><span data-locale="zh">搜索当前简报</span><span data-locale="en">Search loaded issues</span></label>
      <div class="filter-search-box">
       <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
       <input id="brief-search" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="标题、摘要、来源、关键词…" aria-label="搜索已加载资讯的标题、摘要、正文和来源" />
       <button id="brief-search-clear" class="filter-search-clear" type="button" aria-label="清空搜索" hidden>×</button>
      </div>
      <div class="filter-search-scope">
       <span id="search-scope" class="search-scope-text" aria-live="polite"><span data-locale="zh">范围：当前已加载的简报</span><span data-locale="en">Scope: loaded issues</span></span>
       <button id="brief-search-all" class="search-all-button" type="button" hidden><span data-locale="zh">搜索全部归档</span><span data-locale="en">Search all issues</span> ↗</button>
      </div>
     </div>
     <div class="filter-group filter-date-group">
      <span class="filter-group-label"><span data-locale="zh">选择日期</span><span data-locale="en">Issue date</span></span>
      <div class="filter-date-options" id="date-options" role="group" aria-label="归档日期"></div>
      <select id="issues" hidden tabindex="-1" aria-hidden="true" aria-label="当前归档日期"></select>
     </div>
     <div class="filter-group">
      <span class="filter-group-label"><span data-locale="zh">内容分类</span><span data-locale="en">Topics</span></span>
      <div class="filters" id="tabs" role="group" aria-label="内容分类"></div>
     </div>
     <div class="filter-group">
      <span class="filter-group-label"><span data-locale="zh">时间范围</span><span data-locale="en">Period</span></span>
      <div class="quick-dates" id="quick-dates" role="group" aria-label="快捷日期范围">
       <button type="button" data-days="0" aria-pressed="true"><span data-locale="zh">当天</span><span data-locale="en">This day</span></button>
       <button type="button" data-days="3" aria-pressed="false"><span data-locale="zh">近三天</span><span data-locale="en">Last 3 days</span></button>
       <button type="button" data-days="7" aria-pressed="false"><span data-locale="zh">近一周</span><span data-locale="en">Last 7 days</span></button>
      </div>
     </div>
     <div class="filter-group">
      <span class="filter-group-label"><span data-locale="zh">刊期</span><span data-locale="en">Edition</span></span>
      <div class="edition-controls" id="edition-controls" role="group" aria-label="早报晚报">
       <button type="button" data-edition="all" aria-pressed="true"><span data-locale="zh">全部刊期</span><span data-locale="en">Both</span></button>
       <button type="button" data-edition="morning" aria-pressed="false"><span data-locale="zh">早报</span><span data-locale="en">AM</span></button>
       <button type="button" data-edition="evening" aria-pressed="false"><span data-locale="zh">晚报</span><span data-locale="en">PM</span></button>
      </div>
     </div>
    </div>
   </div>
  </div>
 </section>
 <div class="brief-filter-scrim" id="brief-filter-scrim" aria-hidden="true"></div>
 <section class="news wrap" id="issues-section" aria-labelledby="brief-heading">
  <div class="explore-bar" id="spatial-experiment"><span class="explore-caption"><span data-locale="zh">把这一期读成一张地图</span><span data-locale="en">Read this issue as a map</span></span><button id="spatial-open" type="button" aria-haspopup="dialog">◈ <span data-locale="zh">探索空间</span><span data-locale="en">Explore in 3D</span> ↗</button></div>
  <p class="status" id="status" role="status" aria-live="polite"><span data-locale="zh">正在载入每日简报…</span><span data-locale="en">Loading Daily Brief…</span></p>
  <div id="stories" class="stories" aria-live="off"></div>
  <div class="stories-progress" id="stories-progress" hidden>
   <span class="stories-progress-copy" id="stories-progress-copy" aria-live="polite"></span>
   <button type="button" class="stories-load-more" id="stories-load-more">继续加载 ↓</button>
  </div>
  <div class="stories-sentinel" id="stories-sentinel" aria-hidden="true"></div>
  <dialog id="spatial-dialog" aria-labelledby="spatial-heading" aria-describedby="spatial-state"><div class="spatial-shell"><header><h2 id="spatial-heading"><span data-locale="zh">知识空间</span><span data-locale="en">Knowledge Space</span></h2><button id="spatial-close" type="button" aria-label="关闭探索空间">×</button></header><p id="spatial-state" role="status">选择一个节点展开阅读</p><div class="spatial-legend" aria-hidden="true"><span><i class="legend-topic"></i><span data-locale="zh">颜色 = 主题</span><span data-locale="en">Colour = topic</span></span><span><i class="legend-time"></i><span data-locale="zh">高度 = 新近</span><span data-locale="en">Height = recency</span></span><span><i class="legend-edge"></i><span data-locale="zh">连线 = 同主题 / 同来源</span><span data-locale="en">Edge = same topic / source</span></span></div><div class="spatial-viewport" aria-label="可拖动的三维知识网络"><span class="spatial-axis" aria-hidden="true"><span>较新</span><i></i><span>较早</span></span><div class="spatial-tooltip" data-spatial-tooltip hidden></div></div><div id="spatial-scene" class="spatial-scene" aria-label="所选新闻详情"></div><footer><button type="button" data-rotate="-24" aria-label="上一个节点">←</button><div class="spatial-controls"><button type="button" data-spatial-reset><span data-locale="zh">重置视角</span><span data-locale="en">Reset view</span></button><button type="button" data-spatial-zoom="-1" aria-label="缩小">−</button><button type="button" data-spatial-zoom="1" aria-label="放大">+</button></div><button type="button" data-rotate="24" aria-label="下一个节点">→</button></footer><p class="spatial-note"><span data-locale="zh">位置只表达当前列表的主题聚类与时间顺序，不做语义模型推断。</span><span data-locale="en">Positions encode topic clusters and list recency only; no semantic model is inferred.</span></p><p class="spatial-gestures"><span data-locale="zh">单指拖动旋转 · 双指缩放 · 点按节点阅读</span><span data-locale="en">Drag to rotate · pinch to zoom · tap a node to read</span></p></div></dialog>
  <noscript><p>启用 JavaScript 以浏览与筛选每日简报。 / Enable JavaScript to browse and filter Daily Brief.</p></noscript>
  <p class="disclaimer"><span data-locale="zh">简报以 AI 辅助整理公开资讯，仅供信息参考，并非独立事实核查。重要结论请核对原始来源。</span><span data-locale="en">AI-assisted editorial summaries, not independent fact-checking. Verify important claims against original sources.</span></p>
 </section>
</BaseLayout>
<link rel="stylesheet" href="/assets/nav-orb.css?v=5" />
<script is:inline src="/assets/nav-orb.js?v=3" defer></script>
<script>
 import "../../lib/brief-reader";
 import "../../lib/spatial-reader";
</script>
<style>
 .brief-hero{padding-top:clamp(54px,8vw,114px);padding-bottom:clamp(40px,6vw,78px)}
 .brief-hero>h1{font-weight:750;letter-spacing:-.078em;line-height:1.13;font-size:clamp(57px,9.2vw,128px);text-align:center;margin:26px 0 clamp(40px,6vw,75px)}
 .brief-hero>.eyebrow{text-align:center}
 .hero-panel{display:grid;grid-template-columns:1.6fr .8fr;gap:clamp(22px,5vw,80px);align-items:center;background:var(--card);border:1px solid var(--stroke);border-radius:var(--radius);box-shadow:var(--shadow-md);padding:clamp(24px,4vw,55px)}
 .hero-panel>p{max-width:680px;font-size:clamp(14px,1.45vw,18px);line-height:1.95;color:var(--muted);margin:0}
 .hero-panel>p strong{display:block;color:var(--fg);font-weight:660;margin-bottom:8px}
 .issue-summary{border-left:1px solid var(--stroke);padding-left:28px;display:flex;flex-direction:column;gap:9px}
 .issue-summary strong{font-size:clamp(25px,3vw,36px);line-height:1.2;letter-spacing:-.045em}
 .issue-summary small{color:var(--muted)}
 .live-dot{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:9px}
 .hero-foot{display:flex;justify-content:space-between;gap:20px;margin-top:23px;color:var(--muted);font-size:12px}
 .news{padding-block:clamp(60px,7vw,105px) 135px}
 .news-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:38px}
 .news-heading h2{font-size:clamp(36px,5vw,69px);line-height:1.18;letter-spacing:-.06em;margin:14px 0 0}
 .news-heading>p{max-width:350px;color:var(--muted);line-height:1.9;font-size:14px}
 .toolbar{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;border-top:1px solid var(--fg);border-bottom:1px solid var(--stroke);padding:18px 0}
 .filters{display:flex;flex-wrap:wrap;gap:8px}
 :global(.filter-chip){border:1px solid var(--stroke);background:transparent;color:var(--muted);padding:10px 15px;min-height:42px;border-radius:99px;font-size:13px}
 :global(.filter-chip[aria-pressed="true"]){background:var(--fg);color:var(--bg);border-color:var(--fg)}
 .date-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;max-width:100%}
 .quick-dates{display:flex;align-items:center;gap:7px}
 .quick-dates button{border:1px solid var(--stroke);background:var(--card);color:var(--muted);border-radius:999px;min-height:42px;padding:8px 13px;font-size:12px;font-weight:650;cursor:pointer;white-space:nowrap}
 .quick-dates button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
 .quick-dates button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
 .edition-controls{display:flex;gap:5px;align-items:center}
 .edition-controls button{border:1px solid var(--stroke);background:var(--card);color:var(--muted);border-radius:999px;min-height:42px;padding:8px 12px;font-size:12px;font-weight:650;cursor:pointer;white-space:nowrap}
 .edition-controls button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
 .edition-controls button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
 .date-picker{display:flex;align-items:center;gap:13px;font-size:12px;color:var(--muted)}
 .date-picker select{background:var(--card);color:var(--fg);border:1px solid var(--stroke);border-radius:13px;min-height:43px;padding:8px 12px;font:inherit}
 .status{font-size:12px;color:var(--muted);margin:25px 0} .stories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,27px)}
 :global(.news-card){min-width:0;display:flex;flex-direction:column;padding:clamp(20px,2.5vw,32px);border:1px solid var(--stroke);border-radius:22px;background:var(--card);box-shadow:var(--shadow-sm)}
 :global(.news-meta){display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--muted)}
 :global(.news-category){color:var(--accent);font-weight:650}
 :global(.news-card h3){font-size:clamp(19px,2.1vw,27px);line-height:1.45;letter-spacing:-.035em;margin:19px 0 13px}
 :global(.news-card p){font-size:13px;line-height:1.9;color:var(--muted);margin:0 0 13px}
 :global(.news-card .news-reason){border-top:1px solid var(--stroke);padding-top:13px;margin-top:auto}
 :global(.news-card .news-reason b){color:var(--fg)}
 :global(.news-source){border-top:1px solid var(--stroke);padding-top:16px;margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
 :global(.news-source a){color:var(--accent);font-weight:650}
 :global(.news-empty){grid-column:1/-1;text-align:center;padding:65px 20px;color:var(--muted)}
 :global(.news-expanded){margin-top:14px;border-top:1px solid var(--stroke);padding-top:14px;}
 :global(.news-expanded summary){cursor:pointer;display:list-item;color:var(--accent);font-weight:700;font-size:13px;line-height:1.8;padding:7px 0;outline-offset:4px}
 :global(.news-expanded[open] summary){margin-bottom:12px}
 :global(.news-expanded h4){font-size:14px;margin:18px 0 8px;font-weight:700}
 :global(.news-expanded .news-original-title){overflow-wrap:anywhere;color:var(--fg);font-size:13px}
 :global(.news-expanded .news-disclosure-note){margin-top:16px;font-size:12px;color:var(--muted);opacity:.85}
 :global(.news-research){margin:19px 0;padding:clamp(15px,2.3vw,24px);border:1px solid var(--stroke);background:var(--card);border-radius:17px;max-width:100%}
 :global(.news-research h4){font-size:clamp(16px,2vw,20px);margin:0 0 7px;color:var(--fg);line-height:1.5}
 :global(.news-research-scope){color:var(--muted);font-size:12px;line-height:1.65}
 :global(.news-research-part){margin-top:16px;padding-top:15px;border-top:1px solid var(--stroke)}
 :global(.news-research-part h5){font-size:14px;margin:0 0 7px;color:var(--fg);font-weight:750}
 :global(.news-research-part p){font-size:13px;line-height:1.9;overflow-wrap:anywhere}
 :global(.news-research-citations){display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:12px;margin-top:5px;color:var(--muted)}
 :global(.news-research-citations a){display:inline-flex;align-items:center;min-height:34px;padding:5px 11px;border:1px solid var(--stroke);border-radius:99px;color:var(--accent);font-weight:650}
 :global(.news-research-citations a:focus-visible){outline:2px solid var(--accent);outline-offset:2px}

 .disclaimer{max-width:800px;color:var(--muted);font-size:12px;line-height:1.9;margin:55px 0 0}
 @media(max-width:980px){.stories{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:760px){.date-controls{width:100%;justify-content:space-between}.date-picker{flex-wrap:wrap}.hero-panel{grid-template-columns:1fr;gap:22px}.issue-summary{border-left:0;border-top:1px solid var(--stroke);padding:22px 0 0}.news-heading{display:block}.news-heading>p{margin-top:18px}.stories{grid-template-columns:1fr}.news{padding-bottom:95px}}

 /* The Astro route is the production page: a compact masthead puts news first. */
 .brief-hero{padding-top:14px;padding-bottom:14px;border-bottom:1px solid var(--stroke)}
 .brief-masthead{display:flex;justify-content:space-between;align-items:center;gap:20px}
 .brief-hero .eyebrow{margin:0 0 4px;text-align:left}
 .brief-hero h1{font-size:clamp(24px,3.4vw,40px);line-height:1.2;letter-spacing:-.055em;margin:0;text-align:left;font-weight:750}
 .issue-summary{border-left:0;padding:0;gap:2px;align-items:flex-end;flex-shrink:0}
 .issue-summary strong{font-size:14px;line-height:1.3}.issue-summary small{font-size:11px}
 .news{padding-top:16px}.news-heading{margin:0 0 8px}.news-heading h2{font-size:clamp(18px,2.6vw,28px);margin:0}
 .news-heading>p{display:none}.toolbar{padding:8px 0}.status{margin:10px 0;font-size:11px}
 @media(max-width:760px){.brief-hero{padding-top:12px;padding-bottom:12px}.brief-hero h1{font-size:25px}.brief-hero .eyebrow{font-size:10px}.issue-summary strong{font-size:12px}.issue-summary small{font-size:10px}.news{padding-top:11px}.news-heading{margin-bottom:7px}.news-heading h2{font-size:19px}.date-controls{width:auto;justify-content:flex-start}.quick-dates{display:flex}.edition-controls button{min-height:35px;padding:5px 10px;font-size:11px}.date-picker{gap:5px}.date-picker>span{display:none}.date-picker select{min-height:35px;padding:5px 8px;font-size:11px}.toolbar{gap:7px;flex-direction:column;align-items:flex-start}.filters{gap:6px;max-height:38px;overflow:auto;flex-wrap:nowrap;width:100%;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}:global(.filter-chip){min-height:33px;padding:6px 11px;white-space:nowrap;font-size:11px}.stories{gap:12px}:global(.news-card){padding:18px}:global(.news-card h3){margin:10px 0 9px;font-size:21px}}

 /* Editorial flow: wider content, restrained chrome, progressively revealed details. */
 .brief-hero.wrap,.news.wrap{width:min(1560px,calc(100% - 48px));max-width:none}
 .news-heading{display:none}
 .news{padding-top:8px}
 .toolbar{border-top:0;border-bottom:1px solid var(--stroke)}
 .stories{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 30px}
 :global(.news-card){border:0;border-top:1px solid var(--stroke);box-shadow:none;border-radius:0;background:transparent;padding:26px 3px 35px;transition:background-color .3s ease,opacity .3s ease}
 :global(.news-card h3){font-size:clamp(23px,2.4vw,35px);margin:13px 0 13px;line-height:1.35}
 :global(.news-card .news-summary){font-size:clamp(14px,1.1vw,16px);line-height:1.88;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px}
 :global(.news-card .news-reason),:global(.news-card .news-expanded){display:none}
 :global(.news-card.is-reading .news-summary){display:block;overflow:visible}
 :global(.news-card.is-reading .news-reason){display:block}
 :global(.news-card.is-reading .news-expanded){display:block}
 :global(.news-read-toggle){align-self:flex-start;border:0;background:none;color:var(--accent);font:inherit;font-size:12px;padding:8px 0;cursor:pointer}
 :global(.news-read-toggle:focus-visible){outline:2px solid var(--accent);outline-offset:3px}
 :global(.news-source){margin-top:8px;border:0;padding:8px 0 0}
 .disclaimer{margin-top:32px;border-top:1px solid var(--stroke);padding-top:18px;font-size:11px;opacity:.75}
 @media(max-width:760px){
  .brief-hero.wrap,.news.wrap{width:calc(100% - 28px)}
  .brief-hero{padding-block:8px}
  .news{padding-top:4px;padding-bottom:70px}
  .stories{grid-template-columns:minmax(0,1fr);gap:0}
  :global(.news-card){padding:21px 2px 27px;min-width:0}
  :global(.news-card h3){font-size:clamp(23px,6vw,29px);line-height:1.36}
  :global(.news-card .news-summary){font-size:15px;-webkit-line-clamp:2}
  .status{margin:7px 0;font-size:10px}
  .toolbar{padding:6px 0}
  .date-controls{align-self:flex-end}
 }
 @media(prefers-reduced-motion:reduce){:global(.news-card){transition:none}}


 .explore-bar[hidden]{display:none!important}
 .explore-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 0 4px;flex-wrap:wrap}
 .explore-caption{font-size:10px;color:var(--muted);letter-spacing:.04em}
