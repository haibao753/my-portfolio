---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
const {title="J.H. LAB — 让好奇心成为作品",description="数学、AI、影像与有趣的想法。"}=Astro.props;
const canonicalURL=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="J.H. LAB" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href="/assets/jh-orbit.svg" type="image/svg+xml" />
  <title>{title}</title>
  <script is:inline>
   (()=>{try{
    const theme=localStorage.getItem("jhlab-theme");
    document.documentElement.dataset.theme=theme==="dark"||theme==="light"?theme:(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
    const lang=localStorage.getItem("jhlab-locale");
    if(lang==="en")document.documentElement.lang="en";
   }catch{}})();
   </script>
   <slot name="head" />
  </head>
 <body>
  <a href="#main" class="skip-link">跳过导航 / Skip navigation</a>
  <SiteNav />
  <main id="main"><slot /></main>
  <footer class="site-footer wrap">
   <span>© {new Date().getFullYear()} J.H. LAB</span>
   <a href="#top"><span data-locale="zh">返回顶部 ↑</span><span data-locale="en">Back to top ↑</span></a>
  </footer>
  <script>
   import "../lib/motion";
   import { initSiteShell } from "../lib/site-shell";
   initSiteShell();
  </script>
 </body>
</html>
<style>
 .site-footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--stroke);padding-top:32px;padding-bottom:48px;color:var(--muted);font-size:12px}
</style>
