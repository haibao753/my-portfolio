---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
const {title="J.H. LAB — 让好奇心成为作品",description="数学、AI、影像与有趣的想法。"}=Astro.props;
const canonicalURL=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="J.H. LAB" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href="/assets/jh-orbit.svg" type="image/svg+xml" />
  <title>{title}</title>
  <script is:inline>
   (()=>{try{
    const theme=localStorage.getItem("jhlab-theme");
    document.documentElement.dataset.theme=theme==="dark"||theme==="light"?theme:(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
    const lang=localStorage.getItem("jhlab-locale");
    if(lang==="en")document.documentElement.lang="en";
   }catch{}})();
  </script>
 </head>
 <body>
  <a href="#main" class="skip-link">跳过导航 / Skip navigation</a>
  <SiteNav />
  <main id="main"><slot /></main>
  <footer class="site-footer wrap">
   <span>© {new Date().getFullYear()} J.H. LAB</span>
   <a href="#top"><span data-locale="zh">返回顶部 ↑</span><span data-locale="en">Back to top ↑</span></a>
  </footer>
  <script>
   import "../lib/motion";
   const root=document.documentElement;
   const themeButton=document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
   const refreshTheme=()=>{
    if(!themeButton)return;
    const dark=root.dataset.theme==="dark";
    const en=root.lang==="en";
    themeButton.setAttribute("aria-label",en?(dark?"Switch to light mode":"Switch to dark mode"):(dark?"切换至浅色模式":"切换至深色模式"));
    themeButton.setAttribute("title",en?(dark?"Light mode":"Dark mode"):(dark?"浅色模式":"深色模式"));
    themeButton.setAttribute("aria-pressed",String(dark));
   };
   let themeTransitionTimer:ReturnType<typeof setTimeout>|undefined;
   themeButton?.addEventListener("click",()=>{
    const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if(themeTransitionTimer!==undefined)clearTimeout(themeTransitionTimer);
    if(!reduced)root.dataset.themeTransition="true";
    else root.removeAttribute("data-theme-transition");
    root.dataset.theme=root.dataset.theme==="dark"?"light":"dark";
    try{localStorage.setItem("jhlab-theme",root.dataset.theme)}catch{}
    refreshTheme();
    if(!reduced)themeTransitionTimer=setTimeout(()=>{
     root.removeAttribute("data-theme-transition");
     themeTransitionTimer=undefined;
    },560);
   });
   refreshTheme();
   const language=document.querySelector<HTMLButtonElement>("[data-language-toggle]");
   const refreshLanguage=()=>{
    if(!language)return;
    const en=root.lang==="en";
    language.textContent=en?"中文":"EN";
    language.setAttribute("aria-label",en?"切换为中文":"Switch to English");
    document.querySelector("[data-menu-toggle]")?.setAttribute("aria-label",en?"Menu":"菜单");
    document.querySelector(".brand")?.setAttribute("aria-label",en?"J.H. LAB home":"J.H. LAB 首页");
    refreshTheme();
   };
   language?.addEventListener("click",()=>{
    root.lang=root.lang==="en"?"zh-CN":"en";
    try{localStorage.setItem("jhlab-locale",root.lang==="en"?"en":"zh")}catch{}
    refreshLanguage();
   });
   refreshLanguage();
   const menu=document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
   const panel=document.querySelector<HTMLElement>("[data-menu-panel]");
   const backdrop=document.querySelector<HTMLElement>("[data-menu-backdrop]");
   const motionReduced=window.matchMedia("(prefers-reduced-motion: reduce)");
   const header=document.querySelector<HTMLElement>(".glass-nav");
   const positionMenu=()=>{
    if(header&&panel)panel.style.setProperty("--menu-top",Math.ceil(header.getBoundingClientRect().bottom+8)+"px");
   };
   if(header)new ResizeObserver(positionMenu).observe(header);
   window.addEventListener("resize",positionMenu,{passive:true});
   window.visualViewport?.addEventListener("resize",positionMenu,{passive:true});
   positionMenu();
   if(panel)panel.inert=true;
   let closeTimer:ReturnType<typeof setTimeout>|undefined;
   const finishClose=()=>{
    if(!panel||!backdrop)return;
    panel.hidden=true;backdrop.hidden=true;
    panel.inert=true;
    delete panel.dataset.closing;delete backdrop.dataset.closing;
    closeTimer=undefined;
   };
   const close=(restoreFocus=false)=>{
    if(!menu||!panel||!backdrop||panel.hidden||panel.dataset.closing==="true")return;
    const focusWasInside=panel.contains(document.activeElement);
    menu.setAttribute("aria-expanded","false");
    panel.inert=true;
    root.removeAttribute("data-menu-open");
    if(focusWasInside||restoreFocus)menu.focus({preventScroll:true});
    if(motionReduced.matches){finishClose();return;}
    panel.dataset.closing="true";backdrop.dataset.closing="true";
    closeTimer=setTimeout(finishClose,310);
   };
   const openMenu=()=>{
    if(!menu||!panel||!backdrop)return;
    positionMenu();
    if(closeTimer!==undefined){clearTimeout(closeTimer);closeTimer=undefined;}
    delete panel.dataset.closing;delete backdrop.dataset.closing;
    panel.hidden=false;backdrop.hidden=false;
    panel.inert=false;
    menu.setAttribute("aria-expanded","true");
    root.dataset.menuOpen="true";
    panel.querySelector<HTMLAnchorElement>("a")?.focus({preventScroll:true});
   };
   menu?.addEventListener("click",()=>{
    if(menu.getAttribute("aria-expanded")==="true")close();
    else openMenu();
   });
   panel?.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>close()));
   // The visual backdrop deliberately passes through touch scrolling.
   // Dismiss on an outside click without intercepting native touch gestures.
   document.addEventListener("click",event=>{
    if(menu?.getAttribute("aria-expanded")==="true"&&event.target instanceof Node&&!header?.contains(event.target)&&!panel?.contains(event.target))close();
   });
   document.addEventListener("focusin",event=>{
    if(menu?.getAttribute("aria-expanded")==="true"&&event.target instanceof Node&&!header?.contains(event.target)&&!panel?.contains(event.target))close();
   });
   document.addEventListener("keydown",e=>{
    if(e.key==="Escape"&&panel&&!panel.hidden){
     close(true);
     menu?.focus({preventScroll:true});
    }
   });
   // A viewport orientation change can restore desktop navigation mid-session.
   const desktopNav=window.matchMedia("(min-width: 1181px)");
   desktopNav.addEventListener("change",e=>{if(e.matches){if(closeTimer!==undefined)clearTimeout(closeTimer);menu?.setAttribute("aria-expanded","false");root.removeAttribute("data-menu-open");finishClose();}});
   window.addEventListener("pageshow",event=>{
    if(event.persisted && menu?.getAttribute("aria-expanded")==="true"){
     if(closeTimer!==undefined)clearTimeout(closeTimer);
     menu.setAttribute("aria-expanded","false");
     root.removeAttribute("data-menu-open");
     finishClose();
    }
   });
   const copy=document.querySelector<HTMLButtonElement>("[data-copy-wechat]");
   copy?.addEventListener("click",async()=>{
    const id=copy.dataset.copyWechat??"";
    try{
     await navigator.clipboard.writeText(id);
     copy.dataset.copied="true";
     window.setTimeout(()=>{copy.dataset.copied="false"},1500);
    }catch{
     copy.dataset.copied="false";
     window.prompt(root.lang==="en"?"Copy WeChat ID":"复制微信号",id);
    }
   });
   // Shared pointer light for the navigation glass. When the GPU optical layer
   // is active it uses the same tracker, so the CSS fallback and WebGL material
   // never disagree about where the light is. Touch only lights while held.
   const navGlass=document.querySelector<HTMLElement>(".glass-nav");
   if(navGlass){
    const setLight=(x:number,y:number)=>{
     navGlass.style.setProperty("--glass-light-x",`${Math.round(x*100)}%`);
     navGlass.style.setProperty("--glass-light-y",`${Math.round(y*100)}%`);
    };
    let touchLighting=false;
    const track=(event:PointerEvent)=>{
     if(event.pointerType!=="mouse"&&!touchLighting)return;
     const rect=navGlass.getBoundingClientRect();
     if(!rect.width||!rect.height)return;
     setLight(Math.max(0,Math.min(1,(event.clientX-rect.left)/rect.width)),Math.max(0,Math.min(1,(event.clientY-rect.top)/rect.height)));
    };
    navGlass.addEventListener("pointermove",track,{passive:true});
    navGlass.addEventListener("pointerdown",event=>{if(event.pointerType!=="mouse"){touchLighting=true;track(event)}},{passive:true});
    const release=()=>{touchLighting=false;setLight(.28,0)};
    navGlass.addEventListener("pointerleave",()=>{if(!touchLighting)release()});
    navGlass.addEventListener("pointerup",release,{passive:true});
    navGlass.addEventListener("pointercancel",release,{passive:true});
   }
  </script>
 </body>
</html>
<style>
 .site-footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--stroke);padding-top:32px;padding-bottom:48px;color:var(--muted);font-size:12px}
</style>
