---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
const {title="J.H. LAB — 让好奇心成为作品",description="数学、AI、影像与有趣的想法。"}=Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" href="/assets/jh-orbit.svg" type="image/svg+xml" />
  <title>{title}</title>
  <script is:inline>
   (()=>{try{
    const theme=localStorage.getItem("jhlab-theme");
    if(theme==="dark"||theme==="light")document.documentElement.dataset.theme=theme;
    const lang=localStorage.getItem("jhlab-locale");
    if(lang==="en")document.documentElement.lang="en";
   }catch{}})();
  </script>
 </head>
 <body>
  <a href="#main" class="skip-link">跳过导航 / Skip navigation</a>
  <SiteNav />
  <main id="main"><slot /></main>
  <footer class="site-footer wrap">
   <span>© {new Date().getFullYear()} J.H. LAB</span>
   <a href="#top"><span data-locale="zh">返回顶部 ↑</span><span data-locale="en">Back to top ↑</span></a>
  </footer>
  <script>
   const root=document.documentElement;
   const themeButton=document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
   const refreshTheme=()=>{
    if(!themeButton)return;
    const dark=root.dataset.theme==="dark";
    themeButton.setAttribute("aria-label",dark?"切换至浅色模式":"切换至深色模式");
    themeButton.setAttribute("title",dark?"浅色模式":"深色模式");
    themeButton.setAttribute("aria-pressed",String(dark));
   };
   let themeTransitionTimer:ReturnType<typeof setTimeout>|undefined;
   themeButton?.addEventListener("click",()=>{
    const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if(themeTransitionTimer!==undefined)clearTimeout(themeTransitionTimer);
    if(!reduced)root.dataset.themeTransition="true";
    else root.removeAttribute("data-theme-transition");
    root.dataset.theme=root.dataset.theme==="dark"?"light":"dark";
    try{localStorage.setItem("jhlab-theme",root.dataset.theme)}catch{}
    refreshTheme();
    if(!reduced)themeTransitionTimer=setTimeout(()=>{
     root.removeAttribute("data-theme-transition");
     themeTransitionTimer=undefined;
    },560);
   });
   refreshTheme();
   const language=document.querySelector<HTMLButtonElement>("[data-language-toggle]");
   const refreshLanguage=()=>{
    if(!language)return;
    const en=root.lang==="en";
    language.textContent=en?"中文":"EN";
    language.setAttribute("aria-label",en?"切换为中文":"Switch to English");
   };
   language?.addEventListener("click",()=>{
    root.lang=root.lang==="en"?"zh-CN":"en";
    try{localStorage.setItem("jhlab-locale",root.lang==="en"?"en":"zh")}catch{}
    refreshLanguage();
   });
   refreshLanguage();
   const menu=document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
   const panel=document.querySelector<HTMLElement>("[data-menu-panel]");
   const backdrop=document.querySelector<HTMLElement>("[data-menu-backdrop]");
   const motionReduced=window.matchMedia("(prefers-reduced-motion: reduce)");
   let closeTimer:ReturnType<typeof setTimeout>|undefined;
   let lockedScrollY=0;
   const unlockBackground=()=>{
    if(root.dataset.menuActive!=="true")return;
    root.removeAttribute("data-menu-active");
    for(const prop of ["position","top","left","right","width"])document.body.style.removeProperty(prop);
    window.scrollTo({top:lockedScrollY,behavior:"instant"});
   };
   const lockBackground=()=>{
    if(root.dataset.menuActive==="true")return;
    lockedScrollY=window.scrollY;
    Object.assign(document.body.style,{position:"fixed",top:`-${lockedScrollY}px`,left:"0",right:"0",width:"100%"});
    root.dataset.menuActive="true";
   };
   // Keep the backdrop aligned with the visual viewport while the menu is open.
   // Prevent scroll chaining / rubber-banding into the underlying page.
   const preventBackgroundScroll=(event:Event)=>{
    if(root.dataset.menuActive==="true" && !(event.target instanceof Element && event.target.closest("[data-menu-panel]")))event.preventDefault();
   };
   document.addEventListener("touchmove",preventBackgroundScroll,{passive:false});
   document.addEventListener("wheel",preventBackgroundScroll,{passive:false});
   const finishClose=()=>{
    if(!panel||!backdrop)return;
    panel.hidden=true;backdrop.hidden=true;
    unlockBackground();
    delete panel.dataset.closing;delete backdrop.dataset.closing;
    closeTimer=undefined;
   };
   const close=()=>{
    if(!menu||!panel||!backdrop||panel.hidden||panel.dataset.closing==="true")return;
    menu.setAttribute("aria-expanded","false");
    root.removeAttribute("data-menu-open");
    if(motionReduced.matches){finishClose();return;}
    panel.dataset.closing="true";backdrop.dataset.closing="true";
    closeTimer=setTimeout(finishClose,310);
   };
   const openMenu=()=>{
    if(!menu||!panel||!backdrop)return;
    if(closeTimer!==undefined){clearTimeout(closeTimer);closeTimer=undefined;}
    delete panel.dataset.closing;delete backdrop.dataset.closing;
    panel.hidden=false;backdrop.hidden=false;
    menu.setAttribute("aria-expanded","true");
    root.dataset.menuOpen="true";
    lockBackground();
   };
   menu?.addEventListener("click",()=>{
    if(menu.getAttribute("aria-expanded")==="true")close();
    else openMenu();
   });
   backdrop?.addEventListener("click",close);
   panel?.querySelectorAll("a").forEach(a=>a.addEventListener("click",close));
   document.addEventListener("keydown",e=>{if(e.key==="Escape")close()});
   const copy=document.querySelector<HTMLButtonElement>("[data-copy-wechat]");
   copy?.addEventListener("click",async()=>{
    const id=copy.dataset.copyWechat??"";
    try{
     await navigator.clipboard.writeText(id);
     copy.dataset.copied="true";
     window.setTimeout(()=>{copy.dataset.copied="false"},1500);
    }catch{
     copy.dataset.copied="false";
     window.prompt("Copy WeChat ID",id);
    }
   });
  </script>
 </body>
</html>
<style>
 .site-footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--stroke);padding-top:32px;padding-bottom:48px;color:var(--muted);font-size:12px}
</style>
