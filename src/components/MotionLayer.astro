<script>
 // Editorial reveal + a deliberately small scroll depth cue.
 // The depth is measured in single-digit pixels so reading never depends on it;
 // content is fully visible before JS and under reduced motion.
 const reduce=window.matchMedia("(prefers-reduced-motion: reduce)");
 const root=document.documentElement;
 const reveals=[...document.querySelectorAll<HTMLElement>(".intro,.project,.contact,.bilibili-studio,.bili-studio")];
 let observer:IntersectionObserver|null=null;
 function setup(){
  observer?.disconnect();
  // Once revealed, chapters stay visible; restoring a page must not replay them.
  if(reduce.matches||!("IntersectionObserver" in window)){
   root.removeAttribute("data-motion-ready");
   reveals.forEach(el=>el.classList.add("is-motion-revealed"));
   return;
  }
  observer=new IntersectionObserver(entries=>{
   for(const entry of entries){
    if(!entry.isIntersecting)continue;
    (entry.target as HTMLElement).classList.add("is-motion-revealed");
    observer?.unobserve(entry.target);
   }
  },{threshold:0.06,rootMargin:"0px 0px 70px 0px"});
  reveals.forEach(el=>{
   if(el.getBoundingClientRect().top<innerHeight*.87)el.classList.add("is-motion-revealed");
   else observer?.observe(el);
  });
  root.setAttribute("data-motion-ready","");
 }
 const visuals=[...document.querySelectorAll<HTMLElement>(".project .visual")];
 const chapters=[...document.querySelectorAll<HTMLElement>(".project")];
 const coarseMotion=matchMedia("(pointer:coarse)");
 const finale=document.querySelector<HTMLElement>(".lab-finale-graphic");
 let raf=0;
 let lastScroll=scrollY;
 let lastFrame=performance.now();
 let smoothVelocity=0;
 function draw(){
  raf=0;
  if(reduce.matches){
   visuals.forEach(el=>el.style.removeProperty("--motion-y"));
   chapters.forEach(el=>{el.style.removeProperty("--chapter-progress");el.style.removeProperty("--chapter-velocity");el.style.removeProperty("--chapter-tilt")});
   finale?.style.removeProperty("--finale-y");
   smoothVelocity=0;
   lastScroll=scrollY;
   lastFrame=performance.now();
   return;
  }
  // Derive motion entirely from the browser's native scroll position.
  // Never use scrollTo, scroll snapping, wheel/touch interception or delayed settling.
  const now=performance.now();
  const elapsed=Math.max(16,Math.min(100,now-lastFrame));
  const rawVelocity=Math.max(-2.4,Math.min(2.4,(scrollY-lastScroll)/elapsed));
  smoothVelocity+=(rawVelocity-smoothVelocity)*0.28;
  lastScroll=scrollY;
  lastFrame=now;
  const viewport=innerHeight;
  for(const chapter of chapters){
   const rect=chapter.getBoundingClientRect();
   if(rect.bottom<0||rect.top>viewport){
    chapter.style.removeProperty("--chapter-velocity");
    chapter.style.removeProperty("--chapter-tilt");
    continue;
   }
   const progress=Math.max(0,Math.min(1,(viewport-rect.top)/(viewport+rect.height)));
   chapter.style.setProperty("--chapter-progress",progress.toFixed(3));
   chapter.style.setProperty("--chapter-velocity",smoothVelocity.toFixed(3));
   // At most ±0.35°: a hint of material depth, never a parallax ride.
   if(!coarseMotion.matches)chapter.style.setProperty("--chapter-tilt",((progress-0.5)*-.7).toFixed(2)+"deg");
  }
  for(const el of visuals){
   const rect=el.getBoundingClientRect();
   if(rect.bottom<0||rect.top>viewport)continue;
   const phase=Math.max(-1,Math.min(1,(viewport*.5-(rect.top+rect.height*.5))/(viewport*.55+rect.height*.5)));
   el.style.setProperty("--motion-y",`${(phase*(coarseMotion.matches?3:8)).toFixed(1)}px`);
  }
  if(finale){
   const box=finale.getBoundingClientRect();
   if(box.bottom>0&&box.top<viewport){
    const t=Math.max(-1,Math.min(1,(viewport*.5-box.top)/(viewport+box.height)));
    finale.style.setProperty("--finale-y",`${(t*8).toFixed(1)}px`);
   }
  }
 }
 function queue(){if(!raf)raf=requestAnimationFrame(draw)}
 setup();queue();
 addEventListener("scroll",queue,{passive:true});
 addEventListener("resize",queue,{passive:true});
 addEventListener("pageshow",()=>{setup();queue()});
 reduce.addEventListener?.("change",()=>{setup();queue()});
 document.addEventListener("visibilitychange",()=>{if(!document.hidden)queue()});
</script>
<style>
 /* The hero is already fully composed in HTML/CSS; do not blur or hide
    the primary actions while the rest of the page initializes. */
 :global(.hero .actions){animation:none;filter:none;opacity:1;transform:none}
 :global(html[data-motion-ready] .intro:not(.is-motion-revealed)),
 :global(html[data-motion-ready] .project:not(.is-motion-revealed)),
 :global(html[data-motion-ready] .contact:not(.is-motion-revealed)),
 :global(html[data-motion-ready] .bili-studio:not(.is-motion-revealed)),
 :global(html[data-motion-ready] .finale:not(.is-motion-revealed)){opacity:0;transform:translateY(18px)}
 :global(.intro),:global(.project),:global(.contact),:global(.bili-studio),:global(.finale){transition:opacity var(--motion-page) var(--ease-editorial),transform var(--motion-page) var(--ease-editorial)}
 :global(.project .visual){translate:0 var(--motion-y,0px);transition:box-shadow var(--motion-card) ease}
 :global(.project){--chapter-progress:0.5;--chapter-velocity:0;isolation:isolate}
 @media(hover:hover) and (pointer:fine) and (min-width:761px){
  :global(.project .visual){transform:perspective(1200px) rotateX(var(--chapter-tilt,0deg));transform-origin:center}
 }
 :global(.project .visual::after){content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;box-shadow:inset 0 1px rgba(255,255,255,.22)}
 @media(hover:hover) and (pointer:fine){:global(.project:hover){box-shadow:var(--shadow-lg);border-color:color-mix(in srgb,var(--fg) 15%,transparent)}}
 :global(.project .eyebrow){position:relative;width:max-content;max-width:100%;padding-bottom:13px}
 :global(.project .eyebrow::after){content:"";position:absolute;left:0;bottom:2px;width:64px;height:1px;background:var(--accent);opacity:.52;transform:scaleX(.2);transform-origin:left;transition:transform var(--motion-page) var(--ease-editorial)}
 :global(.project.is-motion-revealed .eyebrow::after){transform:scaleX(1)}
 :global(.project .copy h3){transition:letter-spacing var(--motion-card) ease}
 @media(hover:hover){:global(.project:hover .copy h3){letter-spacing:-.056em}}
 :global(.project .project-link),:global(.project .extra){transition:color var(--motion-hover) ease,letter-spacing var(--motion-hover) ease}
 :global(.project .project-link:hover){letter-spacing:.03em}
 :global(.contact-links>a),:global(.contact-links>.wechat){transition:transform var(--motion-card) var(--ease-editorial),box-shadow var(--motion-card) ease}
 :global(.contact-links>a:hover),:global(.contact-links>.wechat:hover){transform:translateY(-3px);box-shadow:var(--shadow-md)}
 :global(.lab-finale-graphic){translate:0 var(--finale-y,0px)}
 :global(.finale){overflow:hidden}
 @media(hover:none){:global(.project:hover){box-shadow:var(--shadow-md)}:global(.contact-links>a:hover),:global(.contact-links>.wechat:hover){transform:none;box-shadow:var(--shadow-sm)}}
 @media(prefers-reduced-motion:reduce){
  :global(.hero .eyebrow),:global(.hero h1),:global(.hero-title-line),:global(.hero .lead),:global(.hero .actions){animation:none!important}
  :global(.intro),:global(.project),:global(.contact),:global(.bili-studio),:global(.finale){opacity:1!important;transform:none!important;transition:none!important}
  :global(.project .visual),:global(.lab-finale-graphic){translate:none!important;transform:none!important}
  :global(.project .visual::after){display:none!important}
 }
</style>
