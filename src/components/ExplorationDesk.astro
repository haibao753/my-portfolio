---
import {Image} from 'astro:assets';
import photo from '../../images/4.jpg';
import {projects} from '../data/site';
const names=[{zh:'每日简报',en:'Daily Brief'},{zh:'数学动画',en:'Math in Motion'},{zh:'三维摄影空间',en:'Photography in 3D'},{zh:'交互几何实验',en:'Interactive Geometry'}];
const questions=[{zh:'世界很大，从哪个问题开始？',en:'A big world. Which question comes first?'},{zh:'如果一个公式，也有自己的风景？',en:'What if a formula had its own landscape?'},{zh:'一张照片，能不能走进去？',en:'Could you walk into a photograph?'},{zh:'几何可不可以，拿在手里玩？',en:'What if geometry were something to play with?'}];
---
<section class="exploration" id="worlds" data-exploration-desk aria-labelledby="worlds-title">
 <header class="desk-meta"><span>01 — WORK & PROJECTS</span><span class="desk-counter"><span data-locale="zh">已了解</span><span data-locale="en">VIEWED</span> <b data-clue-count>0</b> / 4</span></header>
 <div class="lab-desk" data-lab-stage>
  <div class="desk-title" data-reading-anchor><h2 id="worlds-title" data-reading-target><span data-locale="zh">我做的东西，<br/><em>都在这里。</em></span><span data-locale="en">Things I make.<br/><em>Places you can explore.</em></span></h2><p><span data-locale="zh">选一个感兴趣的方向。<br/>点击卡片看介绍，再进入作品。</span><span data-locale="en">Choose something that interests you.<br/>Open a card for details and a link to the project.</span></p></div>
  {projects.map((project,index)=><article id={project.id} class:list={['lab-object','object-'+index]} data-lab-object data-clue={index} data-visited="false" data-reading-anchor>
   <button type="button" class="drag-grip" data-lab-drag data-zh={'移动'+names[index].zh+'，可用方向键'} data-en={'Move '+names[index].en+'; arrow keys also work'} aria-label={'移动'+names[index].zh+'，可用方向键'} aria-describedby="desk-drag-help">⠿</button>
   <a class="object-face" href={project.href} target={project.href.startsWith('http')?'_blank':undefined} rel={project.href.startsWith('http')?'noopener noreferrer':undefined} data-lab-open aria-controls="desk-discovery" aria-expanded="false">
    {index===0&&<div class="poster poster-world" aria-hidden="true" data-reading-target><span class="poster-index">THE DAILY PERSPECTIVE / 01</span><div class="world-globe"><i></i><i></i><i></i></div><strong>WORLD<br/><em>in motion.</em></strong><span class="poster-footer">A NEW DAY. A NEW QUESTION. <b>↗</b></span></div>}
    {index===1&&<div class="poster poster-math" aria-hidden="true" data-reading-target><span class="poster-index">MATHEMATICAL POETRY / 02</span><svg viewBox="0 0 400 300"><g fill="none" stroke="currentColor" stroke-width=".7">{Array.from({length:13},(_,i)=><ellipse cx="200" cy="150" rx="120" ry={18+i*8} transform={'rotate('+i*13.8+' 200 150)'}/>)}</g></svg><strong>∞</strong><span class="poster-footer">THE BEAUTY OF AN IDEA. <b>↗</b></span></div>}
    {index===2&&<div class="poster poster-image" data-reading-target><Image src={photo} alt="" format="webp" quality={82} width={960} widths={[480,960]} sizes="(max-width: 760px) 88vw, 43vw" loading="lazy"/><span class="poster-index" aria-hidden="true">A MOMENT IN SPACE / 03</span><strong aria-hidden="true">a little<br/><em>longer.</em></strong><span class="poster-footer" aria-hidden="true">SOME THINGS DESERVE TO STAY. <b>↗</b></span></div>}
    {index===3&&<div class="poster poster-geometry" aria-hidden="true" data-reading-target><span class="poster-index">UNFINISHED POSSIBILITIES / 04</span><svg viewBox="0 0 400 300"><g fill="none" stroke="currentColor" stroke-width="1">{Array.from({length:19},(_,i)=><ellipse cx="200" cy={45+i*11.5} rx={47+Math.pow((i-9)/9,2)*85} ry={18+Math.abs(i-9)*1.6}/>)}<path d="M68 45Q200 150 68 252M332 45Q200 150 332 252M200 12V284"/></g></svg><span class="geometry-word">WHAT<br/>IF?</span><span class="poster-footer">AN IDEA YOU CAN TOUCH. <b>↗</b></span></div>}
    <span class="object-label"><span class="object-number">0{index+1}</span><span class="object-name"><span data-locale="zh">{names[index].zh}</span><span data-locale="en">{names[index].en}</span></span><span class="object-category"><span data-locale="zh">{project.category.zh.split(' / ')[1]}</span><span data-locale="en">{project.category.en.split(' / ')[1]}</span></span><span class="visited-mark" aria-hidden="true">↗</span></span>
   </a>
   <template data-lab-detail><p class="discovery-kicker"><span data-locale="zh">{project.category.zh}</span><span data-locale="en">{project.category.en}</span></p><h2 id="discovery-title"><span data-locale="zh">{questions[index].zh}</span><span data-locale="en">{questions[index].en}</span></h2><p class="discovery-copy"><span data-locale="zh">{project.description.zh}</span><span data-locale="en">{project.description.en}</span></p><a class="discovery-link" href={project.href} target={project.href.startsWith('http')?'_blank':undefined} rel={project.href.startsWith('http')?'noopener noreferrer':undefined}><span data-locale="zh">{project.action.zh}</span><span data-locale="en">{project.action.en}</span> ↗</a></template>
  </article>)}
  <span class="index-watermark" aria-hidden="true">ALWAYS<br/>BECOMING.</span>
 </div>
 <footer class="desk-tools"><p id="desk-drag-help"><span class="desktop-hint"><span data-locale="zh">拖动 ⠿ 调整排列，点击卡片看作品介绍。</span><span data-locale="en">Drag ⠿ to rearrange. Open a card for project details.</span></span><span class="mobile-hint"><span data-locale="zh">点击卡片看介绍，再进入完整作品。</span><span data-locale="en">Open a card for details and the full project.</span></span></p><div class="desk-buttons" data-lab-controls hidden><button type="button" data-lab-shuffle><span data-locale="zh">重新策展 ⤨</span><span data-locale="en">REARRANGE ⤨</span></button><button type="button" data-lab-surprise><span data-locale="zh">随机看一个作品 ↗</span><span data-locale="en">PICK A PROJECT ↗</span></button><button type="button" data-lab-reset hidden><span data-locale="zh">重新浏览 ↺</span><span data-locale="en">START AGAIN ↺</span></button></div></footer>
 <p class="trail-status" role="status" aria-live="polite" data-lab-status></p>
 <dialog id="desk-discovery" class="discovery" aria-labelledby="discovery-title" data-lab-inspector><button type="button" class="discovery-close" data-lab-close data-zh="收起便签" data-en="Close note" aria-label="收起便签">×</button><div data-lab-discovery-content></div></dialog>
</section>
<script is:inline type="module" src="/assets/exploration-desk.js"></script>
<style>
 .exploration{width:min(1400px,88%);margin:0 auto;padding-top:64px;color:var(--fg)}.desk-meta{display:flex;justify-content:space-between;align-items:center;font:9px ui-monospace,monospace;letter-spacing:.07em;color:var(--muted);border-bottom:1px solid var(--stroke);padding-bottom:19px}.desk-counter{display:flex;gap:9px}.desk-counter b{color:var(--fg);font-weight:400}
 .lab-desk{height:1180px;position:relative;isolation:isolate;overflow:clip}.desk-title{position:absolute;left:3%;right:3%;top:49px;display:flex;align-items:end;justify-content:space-between;gap:30px}.desk-title h2{font-size:clamp(37px,4.5vw,68px);line-height:1.18;letter-spacing:-.07em;font-weight:500;margin:0}.desk-title h2 em{font-family:Georgia,'Songti SC',serif;font-weight:400;font-style:italic;color:var(--muted)}.desk-title p{font-size:12px;line-height:1.9;color:var(--muted);margin:0 5% 0 0}
 .lab-object{position:absolute;width:42%;z-index:2;transform:rotate(var(--angle));transform-origin:center;--angle:0deg;user-select:none}.object-0{left:3%;top:245px;--angle:-2deg}.object-1{left:54%;top:330px;--angle:2deg}.object-2{left:4%;top:680px;--angle:1deg}.object-3{left:53%;top:765px;--angle:-2deg}.lab-object[data-dragging],.lab-object:focus-within{z-index:10}.lab-object[data-dragging]{filter:drop-shadow(0 20px 20px #0002)}
 .object-face{display:block;outline-offset:8px}.poster{height:320px;position:relative;overflow:hidden;isolation:isolate;transition:filter .4s,box-shadow .4s}.object-face:hover .poster{box-shadow:0 20px 35px #0002;filter:saturate(1.12)}.poster-index{position:absolute;left:22px;top:20px;font:7px ui-monospace,monospace;letter-spacing:.12em;z-index:2}.poster-footer{position:absolute;bottom:19px;left:22px;right:22px;display:flex;align-items:center;justify-content:space-between;font:7px ui-monospace,monospace;letter-spacing:.1em;z-index:2}.poster-footer b{font:27px/1 sans-serif;font-weight:300}
 .poster-world{background:#e3dfd3;color:#262923}.poster-world strong{position:absolute;top:71px;left:31px;font:700 clamp(45px,5.4vw,78px)/.9 Georgia,serif;letter-spacing:-.07em;z-index:2}.poster-world strong em{font-weight:400;font-size:.9em}.world-globe{position:absolute;width:260px;height:260px;border:1px solid #2f493331;border-radius:50%;left:48%;top:20px;background:radial-gradient(ellipse at 35% 30%,#cad1b799,#74886f66)}.world-globe:after{content:'';position:absolute;inset:0;border-radius:50%;background:repeating-linear-gradient(0deg,transparent 0 17px,#3f63432b 18px,transparent 19px)}.world-globe i{position:absolute;inset:0 20%;border:1px solid #2f49334d;border-radius:50%}.world-globe i+i{inset:0 36%}.world-globe i:last-child{inset:30% 0}
 .poster-math{background:#29276c;color:#d2ccff}.poster-math svg{position:absolute;width:100%;height:100%;inset:0}.poster-math>strong{position:absolute;left:0;right:0;top:70px;text-align:center;font:110px/1.5 Georgia,serif;color:#e0deff}.poster-math:before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,#d8ceff1a,transparent 60%)}
 .poster-image{color:#fff;background:#243629}.poster-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 48%;filter:brightness(.63) saturate(.6);transition:transform .7s}.poster-image:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 45%,#0c1c2077)}.poster-image strong{position:absolute;top:62px;left:29px;font:400 clamp(44px,5vw,75px)/.92 Georgia,serif;letter-spacing:-.06em;z-index:1}.poster-image strong em{font-weight:400}.object-face:hover .poster-image img{transform:scale(1.04)}.poster-geometry{color:#26301c;background:#d5ed86}.poster-geometry svg{position:absolute;inset:0;width:100%;height:100%;opacity:.75}.geometry-word{position:absolute;right:24px;top:86px;font:600 49px/.88 sans-serif;letter-spacing:-.075em;mix-blend-mode:multiply}
 .object-label{display:flex;align-items:center;gap:10px;padding:17px 1px;color:var(--fg);font-size:12px;border-bottom:1px solid var(--stroke);min-height:58px}.object-number{font:9px ui-monospace,monospace;color:var(--muted)}.object-category{margin-left:auto;color:var(--muted);font-size:9px}.visited-mark{font-size:19px;margin-left:5px}[data-visited="true"] .visited-mark{font-size:0}[data-visited="true"] .visited-mark:after{content:'✓';font-size:13px;color:var(--accent)}
 .drag-grip{position:absolute;right:10px;top:10px;width:40px;height:40px;border:1px solid #ffffff55;border-radius:50%;background:#0c142c33;color:white;z-index:5;font-size:24px;opacity:0;cursor:grab;touch-action:none;backdrop-filter:blur(8px)}[data-lab-ready] .lab-object:hover .drag-grip,[data-lab-ready] .lab-object:focus-within .drag-grip{opacity:1}.drag-grip:active{cursor:grabbing}.index-watermark{position:absolute;bottom:19px;left:3%;font:10px/1.6 ui-monospace,monospace;letter-spacing:.13em;color:var(--muted);opacity:.5}
 .desk-tools{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--stroke);padding-top:18px}.desk-tools p{font-size:10px;color:var(--muted);margin:0}.desk-buttons{display:flex;gap:9px;flex-wrap:wrap}.desk-buttons button{border:1px solid var(--stroke);border-radius:30px;min-height:44px;background:none;color:var(--fg);padding:8px 17px;font:9px ui-monospace,monospace}.desk-buttons [data-lab-surprise]{background:var(--fg);color:var(--bg);border-color:transparent}.mobile-hint{display:none}.trail-status{font-size:11px;color:var(--accent);min-height:20px;margin:17px 0}
 .discovery{position:fixed;inset:auto 24px 24px auto;margin:0;width:380px;max-width:calc(100vw - 28px);padding:29px;border:1px solid var(--stroke);border-radius:3px;background:var(--lab-paper);color:var(--fg);box-shadow:0 20px 80px #0004;z-index:280}.discovery-close{position:absolute;right:9px;top:9px;border:0;background:none;color:var(--muted);width:40px;height:40px;font-size:27px}.discovery :global(.discovery-kicker){font:9px ui-monospace,monospace;color:var(--muted);padding-right:20px;margin-bottom:18px}.discovery :global(h2){font-size:27px;font-weight:500;line-height:1.4;letter-spacing:-.05em;padding-right:9px;margin-bottom:18px}.discovery :global(.discovery-copy){font-size:12px;line-height:1.9;color:var(--muted)}.discovery :global(.discovery-link){display:inline-flex;align-items:center;min-height:44px;font-size:12px;color:var(--accent)}[data-lab-controls][hidden],[data-lab-reset][hidden]{display:none!important}
 @media(min-width:761px) and (max-width:1100px){.poster{height:280px}.lab-desk{height:1100px}.object-0{top:230px}.object-1{top:300px}.object-2{top:630px}.object-3{top:700px}.desk-title p{font-size:10px;margin-right:0}.object-category{display:none}.geometry-word{font-size:39px}.world-globe{left:42%;width:220px;height:220px;top:33px}.poster-world strong{left:22px;top:80px}.poster-image strong{top:80px}.desk-tools p{max-width:210px;line-height:1.8}.desk-buttons button{font-size:8px;padding:8px 13px}}
 @media(max-width:760px){.exploration{width:88%;padding-top:36px}.desk-meta{font-size:7px;padding-bottom:16px}.desk-counter{gap:5px}.lab-desk{height:auto;display:grid;grid-template-columns:1fr;gap:29px;padding:0 5px 62px;overflow:clip}.desk-title{position:relative;inset:auto;display:block;grid-row:1;padding:35px 0 4px}.desk-title h2{font-size:clamp(33px,8.8vw,55px);letter-spacing:-.07em}.desk-title p{font-size:10px;margin-top:22px}.lab-object{position:relative!important;inset:auto!important;width:100%;transform:rotate(var(--angle))!important;grid-column:1!important;min-width:0}.object-0{grid-row:2;--angle:-1deg}.object-1{grid-row:3;--angle:1deg}.object-2{grid-row:4;--angle:-1deg}.object-3{grid-row:5;--angle:1deg}.poster{height:clamp(235px,68vw,350px)}.poster-world strong{font-size:17vw;left:24px;top:69px}.poster-image strong{font-size:17vw;top:63px}.world-globe{width:65vw;height:65vw;left:40%;top:22px}.poster-index{font-size:6px;left:18px;top:17px}.poster-footer{font-size:6px;left:18px;right:18px;bottom:15px}.poster-math>strong{top:50px}.object-label{font-size:11px;gap:8px;padding-block:14px}.object-category{font-size:8px}.drag-grip{display:none!important}.geometry-word{font-size:44px}.index-watermark{bottom:13px;left:5px;font-size:7px}.desk-tools{display:block;padding-top:17px}.desktop-hint{display:none}.mobile-hint{display:inline}.desk-tools p{font-size:9px;margin-bottom:16px}.desk-buttons{gap:7px}.desk-buttons button{font-size:8px;padding:8px 14px}.trail-status{font-size:10px}.discovery{right:12px;bottom:12px;width:calc(100% - 24px);max-height:65svh;overflow:auto;padding:25px}.discovery :global(h2){font-size:24px}.poster-image img{object-position:center 40%}}
 @media(pointer:coarse){.drag-grip{display:none!important}}
 @media(prefers-reduced-motion:reduce){.poster,.poster-image img{transition:none}}
</style>
