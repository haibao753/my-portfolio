---
import {Image} from 'astro:assets';
import photo from '../../images/4.jpg';
import {projects} from '../data/site';
const names=[{zh:'今日的世界',en:'The world, today'},{zh:'一个数学脑洞',en:'A mathematical hunch'},{zh:'捡到一束光',en:'A piece of light'},{zh:'还没做完的实验',en:'An unfinished experiment'}];
const questions=[{zh:'世界很大，从哪个问题开始？',en:'A big world. Which question comes first?'},{zh:'如果一个公式，也有自己的风景？',en:'What if a formula had its own landscape?'},{zh:'一张照片，能不能走进去？',en:'Could you walk into a photograph?'},{zh:'几何可不可以，拿在手里玩？',en:'What if geometry were something to play with?'}];
---
<section class="exploration hero" id="top" data-exploration-desk>
 <header class="desk-meta">
  <span class="studio-label"><i aria-hidden="true"></i> J.H. / OPEN STUDIO</span>
  <span class="desk-counter"><span data-locale="zh">好奇心足迹</span><span data-locale="en">Curiosity trail</span> <b data-clue-count>0</b><span class="counter-total"> / 4</span></span>
 </header>
 <div class="lab-desk" data-lab-stage>
  <div class="desk-title">
   <p class="eyebrow"><span data-locale="zh">一个可以随便逛逛的个人实验室</span><span data-locale="en">A personal space for happy accidents</span></p>
   <h1><span data-locale="zh">让好奇心，<br/><em>自由发生。</em></span><span data-locale="en">Make curiosity<br/><em>a playground.</em></span></h1>
   <p class="desk-intro"><span data-locale="zh">数学、代码、影像，还有一些暂时说不清的念头。<br/>挑个顺眼的，先玩一下。</span><span data-locale="en">Math, code, images, and ideas without a name yet.<br/>Pick something. See where it takes you.</span></p>
  </div>
  <svg class="wandering-line" viewBox="0 0 1200 640" preserveAspectRatio="none" aria-hidden="true"><path d="M165 520C150 635 465 603 469 440S660 251 694 185C735 108 874 142 869 245S1016 498 1096 450"/><path class="line-arrow" d="m1083 442 15 8-13 7"/></svg>
  {projects.map((project,index)=><article class:list={['lab-object',`object-${index}`]} data-lab-object data-clue={index} data-visited="false">
   <button type="button" class="drag-grip" data-lab-drag data-zh={`移动${names[index].zh}，可用方向键`} data-en={`Move ${names[index].en}; arrow keys also work`} aria-label={`移动${names[index].zh}，可用方向键`} aria-describedby="desk-drag-help" title="拖动 / Drag">⠿</button>
   <a class="object-face" href={project.href} target={project.href.startsWith('http')?'_blank':undefined} rel={project.href.startsWith('http')?'noopener noreferrer':undefined} data-lab-open aria-controls="desk-discovery" aria-expanded="false">
    {index===0&&<div class="paper-object" aria-hidden="true"><span class="object-edition">THE DAILY / 01</span><strong>WORLD<br/><i>in focus.</i></strong><div class="paper-rule"></div><p><span data-locale="zh">今天，世界<br/>又有新问题。</span><span data-locale="en">A new day.<br/>A new question.</span></p><span class="paper-arrow">↗</span></div>}
    {index===1&&<div class="math-object" aria-hidden="true"><svg viewBox="0 0 240 240"><g fill="none" stroke="currentColor"><ellipse cx="120" cy="120" rx="103" ry="44" transform="rotate(-28 120 120)"/><ellipse cx="120" cy="120" rx="103" ry="44" transform="rotate(32 120 120)"/><ellipse cx="120" cy="120" rx="103" ry="44" transform="rotate(90 120 120)"/><circle cx="120" cy="120" r="82" stroke-dasharray="2 7" opacity=".4"/></g><circle cx="205" cy="78" r="7" fill="currentColor"/></svg><span>∞</span><small>NOT EVERYTHING<br/>NEEDS AN ANSWER.</small></div>}
    {index===2&&<div class="photo-object"><Image src={photo} alt="" format="webp" quality={80} width={640} widths={[320,640]} sizes="(max-width: 760px) 42vw, 220px" loading="eager" decoding="async"/><span class="photo-caption" aria-hidden="true">a moment, kept. <b>↗</b></span></div>}
    {index===3&&<div class="geometry-object" aria-hidden="true"><span class="geometry-index">EXPERIMENT / 04</span><svg viewBox="0 0 200 150"><g fill="none" stroke="currentColor" stroke-width="1.2"><ellipse cx="100" cy="31" rx="68" ry="22"/><ellipse cx="100" cy="63" rx="35" ry="14"/><ellipse cx="100" cy="90" rx="36" ry="14"/><ellipse cx="100" cy="122" rx="68" ry="22"/><path d="M32 31Q97 76 32 122M168 31Q103 76 168 122M100 9V144M65 12Q113 76 65 140M135 12Q87 76 135 140"/></g></svg><small>TOUCH AN IDEA.</small></div>}
    <span class="object-label"><span class="object-number">0{index+1}</span><span data-locale="zh">{names[index].zh}</span><span data-locale="en">{names[index].en}</span><span class="visited-mark" aria-hidden="true">↗</span></span>
   </a>
   <template data-lab-detail>
    <p class="discovery-kicker"><span data-locale="zh">{project.category.zh}</span><span data-locale="en">{project.category.en}</span></p>
    <h2 id="discovery-title"><span data-locale="zh">{questions[index].zh}</span><span data-locale="en">{questions[index].en}</span></h2>
    <p class="discovery-copy"><span data-locale="zh">{project.description.zh}</span><span data-locale="en">{project.description.en}</span></p>
    <a class="discovery-link" href={project.href} target={project.href.startsWith('http')?'_blank':undefined} rel={project.href.startsWith('http')?'noopener noreferrer':undefined}><span data-locale="zh">{project.action.zh}</span><span data-locale="en">{project.action.en}</span> ↗</a>
   </template>
  </article>)}
  <aside class="desk-note" aria-hidden="true"><span>note to self —</span><strong><span data-locale="zh">允许有点<br/>不务正业。</span><span data-locale="en">Leave room<br/>for a detour.</span></strong><svg viewBox="0 0 110 22"><path d="M2 14Q43 2 102 12M16 21Q55 10 108 17"/></svg></aside>
  <div class="desk-coordinate" aria-hidden="true">FIG. 01 — IDEAS IN THE WILD <span>↗</span></div>
 </div>
 <footer class="desk-tools">
  <p id="desk-drag-help"><span class="desktop-hint"><span data-locale="zh">拖动 ⠿ 随便摆，点击物件找线索。</span><span data-locale="en">Drag ⠿ to rearrange. Open an object to follow a clue.</span></span><span class="mobile-hint"><span data-locale="zh">点开一个物件，跟着好奇心走。</span><span data-locale="en">Open an object. Follow your curiosity.</span></span></p>
  <div class="desk-buttons" data-lab-controls hidden>
   <button type="button" data-lab-shuffle><span aria-hidden="true">⤨</span> <span data-locale="zh">打乱灵感</span><span data-locale="en">Shuffle ideas</span></button>
   <button type="button" data-lab-surprise><span aria-hidden="true">✳</span> <span data-locale="zh">带我随便逛逛</span><span data-locale="en">Surprise me</span></button>
   <button type="button" data-lab-reset hidden><span data-locale="zh">再走一遍 ↺</span><span data-locale="en">Start a new trail ↺</span></button>
  </div>
 </footer>
 <p class="trail-status" role="status" aria-live="polite" data-lab-status></p>
 <dialog id="desk-discovery" class="discovery" aria-labelledby="discovery-title" data-lab-inspector>
  <button type="button" class="discovery-close" data-lab-close data-zh="收起便签" data-en="Close note" aria-label="收起便签">×</button>
  <div data-lab-discovery-content></div>
 </dialog>
</section>
<script is:inline type="module" src="/assets/exploration-desk.js"></script>
<style>
 .exploration{width:min(1400px,calc(100% - 64px));margin:24px auto 0;color:var(--fg)}
 .desk-meta{display:flex;justify-content:space-between;align-items:center;padding:0 10px 18px;font:500 11px ui-monospace,monospace;letter-spacing:.07em}
 .studio-label{display:flex;align-items:center;gap:9px}.studio-label i{width:7px;height:7px;background:var(--lab-green);border-radius:50%}
 .desk-counter{color:var(--muted);display:flex;gap:8px;align-items:center}.desk-counter b{color:var(--fg);font-size:14px}.counter-total{opacity:.5;margin-left:-5px}
 .lab-desk{position:relative;height:650px;isolation:isolate;border-block:1px solid var(--stroke);background-image:radial-gradient(var(--lab-dot) .8px,transparent .8px);background-size:22px 22px;overflow:clip}
 .desk-title{position:absolute;top:37px;left:3.4%;z-index:1;pointer-events:none}.desk-title .eyebrow{font-size:11px;letter-spacing:.08em;margin-bottom:19px}
 h1{font-size:clamp(58px,6.2vw,88px);letter-spacing:-.085em;line-height:1.11;font-weight:730;margin:0 0 20px}h1 em{font-style:normal;color:var(--accent);padding-left:.7em}
 :global(html[lang="en"]) h1{font-size:clamp(50px,6vw,82px);letter-spacing:-.07em}
 .desk-intro{font-size:14px;line-height:1.9;color:var(--muted);margin:0}
 .lab-object{position:absolute;z-index:3;transform:rotate(var(--angle));transform-origin:center;transition:filter .25s ease;user-select:none;--angle:0deg}
 .lab-object[data-dragging]{z-index:25;filter:drop-shadow(0 18px 14px rgba(0,0,0,.12));cursor:grabbing}.lab-object:focus-within{z-index:26}
 .object-0{left:5%;top:360px;width:252px;--angle:-9deg}.object-1{left:52%;top:21px;width:245px;--angle:8deg}.object-2{left:77%;top:241px;width:220px;--angle:9deg}.object-3{left:42%;top:350px;width:210px;--angle:-8deg}
 .object-face{display:block;position:relative;outline-offset:9px;border-radius:4px}.object-face:hover .object-label{color:var(--accent)}
 .drag-grip{position:absolute;z-index:4;right:7px;top:7px;width:40px;height:36px;border:1px solid var(--stroke);background:var(--lab-paper);color:var(--muted);border-radius:20px;cursor:grab;touch-action:none;font-size:22px;opacity:0;transition:opacity .2s}
 [data-lab-ready] .lab-object:hover .drag-grip,[data-lab-ready] .lab-object:focus-within .drag-grip{opacity:1}
 .paper-object{height:220px;padding:17px 20px;color:#272821;background:#f5efde;box-shadow:2px 6px 9px rgba(30,28,18,.12),0 1px 2px rgba(30,28,18,.1);position:relative}
 .object-edition{display:block;font:10px ui-monospace,monospace;letter-spacing:.11em;border-bottom:1px solid #34352d;padding-bottom:8px}.paper-object strong{display:block;font:700 42px/.94 Georgia,serif;letter-spacing:-.07em;margin-top:15px}.paper-object strong i{font-weight:400}.paper-rule{height:3px;border-block:1px solid #8b8879;margin-top:16px}.paper-object p{font-size:13px;line-height:1.4;letter-spacing:.03em;margin:12px 0 0}.paper-arrow{position:absolute;right:20px;bottom:12px;font-size:36px}
 .math-object{height:239px;color:var(--accent);position:relative}.math-object svg{width:100%;height:100%;stroke-width:1.25;filter:drop-shadow(0 2px 1px var(--lab-orbit-shadow))}.math-object>span{position:absolute;inset:52px 0 auto;text-align:center;font:90px/1.2 Georgia,serif;transform:rotate(-8deg)}.math-object small{position:absolute;bottom:2px;left:40px;font:8px/1.5 ui-monospace,monospace;letter-spacing:.11em;transform:rotate(-8deg)}
 .photo-object{padding:11px 11px 0;background:#f9f8f5;box-shadow:2px 7px 12px rgba(0,0,0,.17);position:relative;color:#303832}.photo-object::before{content:'';position:absolute;top:-12px;left:68px;width:77px;height:26px;background:rgba(211,209,182,.52);transform:rotate(-5deg);z-index:1;backdrop-filter:blur(1px)}.photo-object img{display:block;width:100%;height:225px;object-fit:cover;object-position:50% 45%;pointer-events:none}.photo-caption{display:flex;align-items:center;justify-content:space-between;padding:13px 3px;font:italic 16px Georgia,serif}.photo-caption b{font-style:normal;font-weight:400}
 .geometry-object{height:205px;border:1px solid var(--lab-glass-rim);border-radius:36px;background:linear-gradient(140deg,var(--lab-glass),transparent);box-shadow:inset 0 1px 2px rgba(255,255,255,.7),inset 0 -2px 2px rgba(75,135,184,.18),0 16px 30px rgba(58,99,133,.09);backdrop-filter:blur(2px);color:var(--accent);position:relative;overflow:hidden}.geometry-object::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 0,rgba(255,255,255,.8),transparent 60%);pointer-events:none}.geometry-object svg{position:absolute;width:170px;left:20px;top:36px}.geometry-index{position:absolute;top:16px;left:20px;font:8px ui-monospace,monospace;letter-spacing:.13em}.geometry-object small{position:absolute;bottom:13px;width:100%;text-align:center;font:8px ui-monospace,monospace;letter-spacing:.13em}
 .object-label{display:flex;align-items:center;gap:6px;margin-top:13px;font-size:11px;font-weight:500;line-height:1.5;color:var(--muted);padding-inline:4px;transition:color .2s;white-space:nowrap}.object-number{font:9px ui-monospace,monospace;opacity:.55}.visited-mark{margin-left:auto;color:var(--accent)}[data-visited="true"] .visited-mark{font-size:0}[data-visited="true"] .visited-mark::after{content:'✓';font-size:12px}
 .desk-note{position:absolute;left:72%;top:26px;z-index:2;width:145px;padding:15px 17px 12px;background:#ede99e;color:#4a4c25;transform:rotate(-8deg);box-shadow:1px 4px 5px rgba(50,51,23,.08)}.desk-note>span{font:10px Georgia,serif;font-style:italic}.desk-note strong{display:block;font-size:18px;font-weight:500;line-height:1.55;margin-top:5px}.desk-note svg{width:110px;height:22px;fill:none;stroke:#777943;stroke-width:1.2;margin-top:8px}
 .wandering-line{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke:var(--lab-line);stroke-width:1.15;stroke-dasharray:3 7;pointer-events:none;z-index:0}.wandering-line .line-arrow{stroke-dasharray:none}
 .desk-coordinate{position:absolute;bottom:19px;left:32px;font:8px ui-monospace,monospace;letter-spacing:.1em;color:var(--muted);opacity:.55}.desk-coordinate span{margin-left:20px}
 .desk-tools{display:flex;justify-content:space-between;align-items:center;gap:15px;min-height:74px;padding-inline:10px}.desk-tools p{margin:0;color:var(--muted);font-size:11px}.desk-buttons{display:flex;gap:8px;flex-wrap:wrap}.desk-buttons button{min-height:44px;border:1px solid var(--stroke);border-radius:24px;padding:7px 15px;background:transparent;color:var(--fg);font-size:12px}.desk-buttons button:hover{background:var(--card)}.desk-buttons [data-lab-surprise]{background:var(--fg);color:var(--bg);border-color:transparent}.desk-buttons [data-lab-surprise]:hover{opacity:.82}.mobile-hint{display:none}.trail-status{min-height:21px;margin:0 10px;color:var(--accent);font-size:12px}
 .discovery{position:fixed;inset:auto 24px 24px auto;margin:0;width:370px;max-width:calc(100vw - 28px);padding:27px;border:1px solid var(--stroke);border-radius:20px;background:var(--lab-paper);color:var(--fg);box-shadow:0 18px 70px rgba(0,0,0,.18);z-index:280}.discovery-close{position:absolute;right:9px;top:8px;border:0;background:transparent;color:var(--muted);width:38px;height:38px;font-size:26px}.discovery :global(.discovery-kicker){font:10px ui-monospace,monospace;letter-spacing:.04em;color:var(--muted);padding-right:20px;margin:0 0 13px}.discovery :global(h2){font-size:25px;line-height:1.4;letter-spacing:-.05em;margin:0 0 14px;padding-right:8px}.discovery :global(.discovery-copy){font-size:13px;line-height:1.85;color:var(--muted);margin-bottom:18px}.discovery :global(.discovery-link){display:inline-flex;align-items:center;gap:8px;color:var(--accent);font-size:13px;min-height:44px}
 [data-lab-controls][hidden],[data-lab-reset][hidden]{display:none!important}
 @media(min-width:761px) and (max-width:1100px){.lab-desk{height:710px}.object-0{left:4%;top:350px;width:225px}.object-1{left:60%;top:32px;width:220px}.object-2{left:69%;top:347px;width:190px}.photo-object img{height:205px}.object-3{left:36%;top:440px;width:195px}.desk-note{left:40%;top:270px;width:130px}.desk-title{left:3%}h1{font-size:64px}.desk-tools{align-items:flex-start;padding-top:16px}.desk-tools>p{max-width:220px}.desk-buttons{justify-content:flex-end}}
 @media(max-width:760px){.exploration{width:calc(100% - 32px);margin-top:22px}.desk-meta{padding-inline:0;font-size:9px;letter-spacing:.025em}.desk-counter{gap:5px;font-size:9px}.desk-title{position:relative;inset:auto;grid-column:1/-1;padding:27px 3px 15px}.desk-title .eyebrow{font-size:10px;margin-bottom:14px}h1{font-size:clamp(46px,12.5vw,72px);margin-bottom:17px}.desk-intro{font-size:12px;line-height:1.8}.lab-desk{height:auto;display:grid;grid-template-columns:1fr 1fr;gap:33px 18px;padding:0 8px 52px;overflow:hidden}.lab-object{position:relative!important;inset:auto!important;width:100%;align-self:center;min-width:0;transform:rotate(var(--angle))!important}.object-0{--angle:-5deg;grid-column:1;grid-row:2}.object-1{--angle:6deg;grid-column:2;grid-row:2}.object-2{--angle:5deg;grid-column:2;grid-row:3}.object-3{--angle:-5deg;grid-column:1;grid-row:3}.paper-object{height:185px;padding:12px}.object-edition{font-size:7px;padding-bottom:7px}.paper-object strong{font-size:clamp(28px,8vw,44px);margin-top:13px}.paper-rule{margin-top:12px}.paper-object p{font-size:10px;margin-top:9px}.paper-arrow{font-size:27px;right:12px;bottom:12px}.math-object{height:185px}.math-object>span{font-size:70px;inset:40px 0 auto}.math-object small{font-size:5.5px;left:21%;bottom:6px}.object-label{font-size:10px;gap:4px;margin-top:11px;white-space:normal;min-height:30px}.object-number{font-size:7px}.photo-object{padding:8px 8px 0}.photo-object img{height:190px}.photo-object::before{left:32%;width:55px;height:21px;top:-9px}.photo-caption{font-size:11px;padding:11px 0}.geometry-object{height:170px;border-radius:28px}.geometry-index{font-size:6px;left:11px;top:13px}.geometry-object svg{width:85%;left:7.5%;top:25px}.geometry-object small{font-size:6px;bottom:11px}.desk-note{display:none}.drag-grip{display:none!important}.wandering-line{display:none}.desk-coordinate{left:6px;bottom:14px;font-size:6px}.desk-tools{padding:15px 0 7px;display:block}.desk-tools>p{font-size:10px;margin-bottom:11px}.desktop-hint{display:none}.mobile-hint{display:inline}.desk-buttons{gap:6px}.desk-buttons button{font-size:11px;padding:7px 12px}.trail-status{margin:5px 0;font-size:11px;min-height:32px}.discovery{bottom:12px;right:12px;width:calc(100% - 24px);max-height:60svh;overflow:auto;padding:24px}.discovery :global(h2){font-size:23px}}
 @media(max-width:760px){.lab-desk{padding-inline:14px}:global(html[lang="en"]) h1{font-size:clamp(34px,10.5vw,56px)}}
 @media(pointer:coarse){.drag-grip{display:none!important}}
 @media(prefers-reduced-motion:reduce){.lab-object,.object-label,.drag-grip{transition:none!important}}
</style>
