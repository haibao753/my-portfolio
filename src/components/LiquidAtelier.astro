---
import {Image} from 'astro:assets';
import photoA from '../../images/4.jpg';
import photoB from '../../images/5.jpg';
---
<section class="liquid-atelier" id="light" data-liquid-atelier aria-labelledby="liquid-title">
 <header class="atelier-heading">
  <div><p class="eyebrow">J.H. / OPTICAL PLAYGROUND</p><h2 id="liquid-title"><span data-locale="zh">让光，<em>自由流动。</em></span><span data-locale="en">Let the light <em>wander.</em></span></h2></div>
  <p class="atelier-intro"><span data-locale="zh">玻璃也有自己的呼吸。圆润、舒展，再化成一滴光。<br/>拖一拖，转一转，或暂停，留住喜欢的形状。</span><span data-locale="en">Glass breathes. A circle stretches, then flows into a drop.<br/>Move it. Turn it. Pause on a shape you love.</span></p>
 </header>
 <div class="optical-stage" data-optical-stage aria-label="可拖动的液态玻璃光影画布 / Interactive liquid glass">
  <div class="plate-fallback" aria-hidden="true"><span>LIQUID<br/><i>in motion.</i></span><div></div></div>
  <canvas class="optical-backdrop" data-optical-backdrop aria-hidden="true"></canvas>
  <div class="source-images" hidden><Image data-plate-photo="a" src={photoA} alt="" width={960} widths={[640,960]} format="webp" quality={80} loading="eager"/><Image data-plate-photo="b" src={photoB} alt="" width={960} widths={[640,960]} format="webp" quality={80} loading="eager"/></div>
  {[0,1,2].map(index=><div class:list={['free-lens',`lens-${index}`]} data-free-lens={index}>
   <canvas aria-hidden="true"></canvas>
   <button type="button" class="lens-grab" data-lens-grab aria-label={`移动玻璃 ${index+1}；方向键移动，Shift 加左右键旋转`} aria-describedby="lens-help"><span class="lens-grab-mark" aria-hidden="true">⠿</span></button>
   <button type="button" class="lens-turn" data-lens-turn aria-label={`旋转玻璃 ${index+1}`} title="旋转 / Rotate">⟳</button>
  </div>)}
  <span class="stage-edition" aria-hidden="true">STUDY NO. 01 <i>—</i> LIGHT, HELD FOR A MOMENT.</span>
 </div>
 <footer class="atelier-controls">
  <div class="scene-controls" role="group" aria-label="光影背景 / Background">
   <button type="button" data-optical-preset="spectrum" aria-pressed="true"><span data-locale="zh">光谱</span><span data-locale="en">Spectrum</span></button>
   <button type="button" data-optical-preset="photo" aria-pressed="false"><span data-locale="zh">影像</span><span data-locale="en">Images</span></button>
   <button type="button" data-optical-preset="type" aria-pressed="false"><span data-locale="zh">字形</span><span data-locale="en">Type</span></button>
  </div>
  <div class="motion-controls">
   <label class="thickness-control"><span data-locale="zh">厚度</span><span data-locale="en">Depth</span><input type="range" min="12" max="32" value="22" data-lens-thickness aria-label="玻璃厚度 / Glass depth"/></label>
   <button type="button" data-optical-remix><span aria-hidden="true">⤨</span> <span data-locale="zh">换条轨迹</span><span data-locale="en">New orbit</span></button>
   <button type="button" class="pause-control" data-optical-pause aria-pressed="false"><span data-motion-label>暂停动画</span></button>
  </div>
 </footer>
 <p class="optical-help" id="lens-help"><span data-locale="zh">拖动玻璃探索光影 · 拖动 ⟳ 旋转 · 手指上下滑动仍可浏览页面</span><span data-locale="en">Drag glass to explore · Drag ⟳ to rotate · Swipe vertically to scroll</span><span class="keyboard-help"><span data-locale="zh"> · 方向键移动，Shift + 左右键旋转</span><span data-locale="en"> · Arrow keys move, Shift + left/right rotates</span></span></p>
 <p class="optical-fallback-note" data-optical-fallback hidden><span data-locale="zh">此设备使用静态玻璃，仍可拖动和切换背景。</span><span data-locale="en">Static glass is available on this device. Move it or change the background.</span></p>
</section>
<script is:inline type="module" src="/assets/liquid-atelier.js"></script>
<style>
 .liquid-atelier{width:min(1400px,calc(100% - 64px));margin:32px auto 90px}.atelier-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:0 14px 28px}.atelier-heading .eyebrow{font:10px ui-monospace,monospace;letter-spacing:.15em;margin-bottom:16px}.atelier-heading h2{font-size:clamp(38px,5vw,70px);line-height:1.13;font-weight:650;letter-spacing:-.075em;margin:0}.atelier-heading h2 em{font-style:normal;color:var(--accent)}.atelier-intro{font-size:12px;line-height:1.9;color:var(--muted);margin:0 0 3px;max-width:350px}
 .optical-stage{position:relative;height:clamp(440px,39vw,560px);isolation:isolate;overflow:hidden;border:1px solid var(--stroke);border-radius:32px;background:var(--lab-paper)}.optical-backdrop{position:absolute;inset:0;width:100%;height:100%;display:none}.plate-fallback{position:absolute;inset:0;overflow:hidden;background:linear-gradient(120deg,#c8e7f2,#f5eddf 55%,#ffb097)}.plate-fallback>span{position:absolute;left:8%;top:15%;font:700 clamp(70px,11vw,170px)/1 Georgia,serif;letter-spacing:-.08em;color:#153440}.plate-fallback i{font-weight:400}.plate-fallback>div{position:absolute;right:12%;bottom:12%;width:22%;height:45%;border:22px solid #0b70ed;border-radius:50%}.liquid-atelier[data-optical-ready] .optical-backdrop{display:block}.liquid-atelier[data-optical-ready] .plate-fallback{display:none}
 .free-lens{position:absolute;left:18%;top:18%;width:316px;height:190px;border-radius:90px;transform:rotate(-18deg);z-index:2;will-change:transform}.lens-1{left:64%;top:24%;width:216px;height:234px;border-radius:100px;transform:rotate(22deg)}.lens-2{left:32%;top:70%;width:358px;height:110px;border-radius:54px;transform:rotate(9deg)}.free-lens>canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;filter:drop-shadow(0 18px 13px rgba(26,43,65,.15))}.free-lens[data-lens-fallback]{border:1px solid rgba(255,255,255,.65);background:linear-gradient(145deg,rgba(255,255,255,.34),rgba(196,223,244,.08));box-shadow:inset 0 2px 2px rgba(255,255,255,.9),inset 0 -2px 3px rgba(28,80,125,.28),0 18px 24px rgba(26,43,65,.12);backdrop-filter:blur(2px)}.lens-grab{position:absolute;inset:0;border:0;border-radius:inherit;background:transparent;touch-action:pan-y;cursor:grab}.lens-grab:active{cursor:grabbing}.lens-grab-mark{font-size:24px;color:#18364a;background:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.8);border-radius:50%;height:42px;width:42px;display:grid;place-items:center;margin:auto;opacity:0;transition:opacity .2s}.lens-turn{position:absolute;right:-13px;top:-16px;height:44px;width:44px;border:1px solid var(--stroke);border-radius:50%;background:var(--lab-paper);color:var(--fg);font-size:24px;touch-action:none;opacity:0;transition:opacity .2s;cursor:crosshair}.free-lens:hover .lens-turn,.free-lens:focus-within .lens-turn,.free-lens[data-manipulating] .lens-turn,.free-lens:hover .lens-grab-mark,.free-lens:focus-within .lens-grab-mark{opacity:1}.free-lens:focus-within{z-index:5}.stage-edition{position:absolute;bottom:17px;left:24px;font:8px ui-monospace,monospace;letter-spacing:.1em;opacity:.56;color:#243d4c;pointer-events:none;z-index:1}.stage-edition i{padding-inline:9px}
 .atelier-controls{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:17px 5px 0}.scene-controls,.motion-controls{display:flex;align-items:center;gap:8px}.atelier-controls button{min-height:44px;padding:8px 16px;border:1px solid var(--stroke);border-radius:25px;background:transparent;color:var(--fg);font-size:12px}.scene-controls button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:transparent}.motion-controls .pause-control{min-width:104px}.thickness-control{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);margin-right:10px}.thickness-control input{width:80px;accent-color:var(--accent);height:44px}.optical-help{font-size:10px;color:var(--muted);padding-inline:5px;margin-top:14px;line-height:1.8}.optical-fallback-note{font-size:12px;color:var(--muted)}[data-optical-fallback][hidden]{display:none}.liquid-atelier:not([data-optical-ready]) .atelier-controls{visibility:hidden}
 @media(max-width:1000px){.atelier-heading{align-items:start;flex-direction:column;gap:15px}.atelier-intro br{display:none}.atelier-intro{max-width:none}.atelier-controls{align-items:start}.motion-controls{flex-wrap:wrap;justify-content:flex-end}.thickness-control{margin-right:0}}
 @media(max-width:760px){.liquid-atelier{width:calc(100% - 28px);margin-top:30px;margin-bottom:60px}.atelier-heading{padding:0 6px 23px;gap:13px}.atelier-heading h2{font-size:clamp(33px,8.6vw,50px)}.atelier-heading h2 em{display:block;margin-left:.7em}.atelier-heading .eyebrow{font-size:8px;margin-bottom:13px}.atelier-intro{font-size:11px;max-width:330px}.optical-stage{height:540px;border-radius:25px}.free-lens{width:190px;height:130px;border-radius:65px;left:4%;top:22%}.lens-1{width:135px;height:150px;left:58%;top:45%;border-radius:65px}.lens-2{width:185px;height:76px;left:15%;top:76%;border-radius:38px}.lens-turn{opacity:.75;height:44px;width:44px;right:-9px;top:-15px}.stage-edition{font-size:6px;left:16px;bottom:13px;letter-spacing:.03em}.atelier-controls{flex-direction:column;gap:10px;padding-top:14px}.scene-controls{width:100%;gap:6px}.scene-controls button{flex:1}.motion-controls{width:100%;gap:6px;justify-content:space-between}.atelier-controls button{font-size:11px;padding:7px 12px}.motion-controls .pause-control{min-width:90px}.thickness-control{font-size:10px;gap:5px}.thickness-control input{width:62px}.optical-help{font-size:9px;margin-top:11px}.keyboard-help{display:none}}
 @media(prefers-reduced-motion:reduce){.lens-turn,.lens-grab-mark{transition:none}}
</style>
