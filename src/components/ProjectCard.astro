---
import type {Project} from "../data/site";
import {experiments} from "../data/site";
import ProjectVisual from "./ProjectVisual.astro";
interface Props {project:Project;index:number}
const {project,index}=Astro.props;
const external=project.href.startsWith("http");
const isLab=project.id==="experiments";
---
<article class:list={["project",`project--${project.id}`]} id={project.id} data-project={project.id}>
 <div class="copy">
  <div class="eyebrow"><span class="project-number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span><span data-locale="zh">{project.category.zh}</span><span data-locale="en">{project.category.en}</span></div>
  <h3><span data-locale="zh">{project.title.zh}</span><span data-locale="en">{project.title.en}</span></h3>
  <p class="project-description"><span data-locale="zh">{project.description.zh}</span><span data-locale="en">{project.description.en}</span></p>
  {project.facts && <ul class="project-facts">{project.facts.map(fact=><li><span data-locale="zh">{fact.zh}</span><span data-locale="en">{fact.en}</span></li>)}</ul>}
  {isLab && <ol class="experiment-index" aria-label="实验目录 / Experiment index">
   {experiments.map(experiment=><li>
    <a href={experiment.href}>
     <span class="experiment-number" aria-hidden="true">{experiment.index}</span>
     <span class="experiment-copy"><strong data-locale="zh">{experiment.title.zh}</strong><strong data-locale="en">{experiment.title.en}</strong><small data-locale="zh">{experiment.subtitle.zh}</small><small data-locale="en">{experiment.subtitle.en}</small></span>
     <span class="experiment-arrow" aria-hidden="true">↗</span>
    </a>
   </li>)}
  </ol>}
  <div class="project-links">
   <a class="project-link" href={project.href} target={external?"_blank":undefined} rel={external?"noopener noreferrer":undefined}>
    <span data-locale="zh">{project.action.zh}</span><span data-locale="en">{project.action.en}</span> <span class="project-arrow" aria-hidden="true">↗</span>
   </a>
   {project.external && <span class="external-tag"><span data-locale="zh">站外</span><span data-locale="en">External</span></span>}
   {project.extra?.map(link=><a class="extra" href={link.href} target={link.href.startsWith("http")?"_blank":undefined} rel={link.href.startsWith("http")?"noopener noreferrer":undefined}><span data-locale="zh">{link.label.zh}</span><span data-locale="en">{link.label.en}</span> ↗</a>)}
  </div>
 </div>
 <ProjectVisual index={index} project={project} />
</article>
<style>
 .project{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:clamp(24px,4.4vw,64px);align-items:center;padding:clamp(28px,4.4vw,62px);border:1px solid var(--stroke);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-md);overflow:hidden;scroll-margin-top:calc(var(--nav-height) + 32px);position:relative;transition:box-shadow var(--motion-card) ease,border-color var(--motion-card) ease}
 .project::before{content:"";position:absolute;inset:0 0 auto;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);pointer-events:none}
 .copy{position:relative;z-index:1;min-width:0}
 .copy .eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:18px;font-size:11px;letter-spacing:.1em}
 .project-number{display:inline-flex;align-items:center;justify-content:center;min-width:26px;height:22px;padding:0 6px;border:1px solid var(--stroke);border-radius:7px;color:var(--muted);font-size:10px;font-variant-numeric:tabular-nums}
 h3{font-size:clamp(31px,4vw,56px);line-height:1.16;letter-spacing:-.062em;margin-bottom:15px;max-width:16em}
 .project-description{max-width:460px;font-size:clamp(14px,1.3vw,16px);line-height:1.9;color:var(--muted);margin-bottom:16px}
 .project-facts{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:6px;max-width:460px}
 .project-facts li{position:relative;padding-left:15px;font-size:12px;line-height:1.65;color:var(--muted)}
 .project-facts li::before{content:"";position:absolute;left:0;top:.65em;width:5px;height:5px;border-radius:50%;background:var(--accent);opacity:.8}
 .project-links{display:flex;flex-wrap:wrap;align-items:center;gap:9px 18px;margin-top:4px}
 .project-link{display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-size:14px;font-weight:650;padding:8px 0;min-height:44px}
 .project-arrow{display:inline-block;transition:transform var(--motion-card) var(--ease-editorial)}
 .external-tag{display:inline-flex;align-items:center;min-height:24px;padding:2px 8px;border:1px solid var(--stroke);border-radius:999px;color:var(--muted);font-size:10px;font-weight:650;letter-spacing:.06em;text-transform:uppercase}
 .extra{display:inline-flex;align-items:center;min-height:44px;font-size:12px;color:var(--muted)}
 @media(hover:hover) and (pointer:fine){.project-link:hover .project-arrow{transform:translate(3px,-3px)}.extra:hover{color:var(--fg)}}
 .experiment-index{list-style:none;margin:2px 0 24px;padding:0;display:grid;gap:2px;max-width:480px;border-top:1px solid var(--stroke)}
 .experiment-index li{border-bottom:1px solid var(--stroke)}
 .experiment-index a{display:grid;grid-template-columns:34px minmax(0,1fr) 18px;align-items:center;gap:10px;min-height:58px;padding:9px 4px;color:var(--fg)}
 .experiment-number{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;letter-spacing:.06em}
 .experiment-copy{display:flex;flex-direction:column;gap:2px;min-width:0}
 .experiment-copy strong{font-size:13px;font-weight:650;line-height:1.4}
 .experiment-copy small{font-size:11px;color:var(--muted);line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .experiment-arrow{color:var(--muted);transition:transform var(--motion-card) var(--ease-editorial),color var(--motion-hover) ease}
 @media(hover:hover) and (pointer:fine){.experiment-index a:hover .experiment-arrow{transform:translate(2px,-2px);color:var(--accent)}.experiment-index a:hover strong{color:var(--accent)}}
 @media(min-width:901px){.project--observation,.project--experiments{background:linear-gradient(145deg,var(--card),var(--bg))}}
 @media(min-width:901px){.project:nth-child(even) .visual{grid-column:1;grid-row:1}.project:nth-child(even) .copy{grid-column:2;grid-row:1}}
 @media(max-width:900px){.project{grid-template-columns:1fr;gap:22px}.visual{min-height:0}}
 @media(max-width:600px){.project{padding:22px;border-radius:23px}h3{font-size:clamp(29px,8vw,38px)}.project-description{font-size:14px}.project-facts{font-size:11px;margin-bottom:18px}.project-links{gap:4px 14px}.experiment-index a{min-height:56px}}
 @media(prefers-reduced-motion:reduce){.project,.project-arrow,.experiment-arrow{transition:none!important}}
</style>
