---
import type {Project} from "../data/site";
import ProjectVisual from "./ProjectVisual.astro";
interface Props {project:Project;index:number}
const {project,index}=Astro.props;
const external=project.href.startsWith("http");
---
<article class="project" id={project.id}>
 <div class="copy">
  <div class="eyebrow"><span data-locale="zh">{project.category.zh}</span><span data-locale="en">{project.category.en}</span></div>
  <h3><span data-locale="zh">{project.title.zh}</span><span data-locale="en">{project.title.en}</span></h3>
  <p><span data-locale="zh">{project.description.zh}</span><span data-locale="en">{project.description.en}</span></p>
  <a class="project-link" href={project.href} target={external?"_blank":undefined} rel={external?"noopener noreferrer":undefined}>
   <span data-locale="zh">{project.action.zh}</span><span data-locale="en">{project.action.en}</span> <span aria-hidden="true">↗</span>
  </a>
  {project.extra?.map(link=><a class="extra" href={link.href} target={link.href.startsWith("http")?"_blank":undefined} rel={link.href.startsWith("http")?"noopener noreferrer":undefined}><span data-locale="zh">{link.label.zh}</span><span data-locale="en">{link.label.en}</span> ↗</a>)}
 </div>
 <ProjectVisual index={index} href={project.href} />
</article>
<style>
 .project{display:grid;grid-template-columns:1fr 1.08fr;gap:clamp(24px,5vw,74px);align-items:center;min-height:500px;padding:clamp(29px,5vw,72px);border:1px solid var(--stroke);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-md);overflow:hidden;scroll-margin-top:100px;position:relative;transition:box-shadow .4s ease,border-color .4s ease}
 .project::before{content:"";position:absolute;inset:0 0 auto;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);pointer-events:none}
 .copy{position:relative;z-index:1;min-width:0}
 .copy .eyebrow{margin-bottom:20px}
 h3{font-size:clamp(34px,4.4vw,63px);line-height:1.18;letter-spacing:-.064em;margin-bottom:17px}
 .copy p{max-width:450px;font-size:clamp(14px,1.4vw,17px);line-height:1.95;color:var(--muted);margin-bottom:27px}
 .project-link{display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-size:14px;font-weight:650}
 .extra{display:block;font-size:13px;margin-top:12px;color:var(--muted)}
 .project-link{padding:8px 0;min-height:44px}
 .project-link span[aria-hidden]{display:inline-block;transition:transform .32s cubic-bezier(.16,1,.3,1)}
 @media(hover:hover){.project-link:hover span[aria-hidden]{transform:translate(3px,-3px)}}
 @media(prefers-reduced-motion:reduce){.project,.project-link span[aria-hidden]{transition:none!important}}
 @media(min-width:901px){.project:nth-child(even){background:linear-gradient(145deg,var(--card),var(--bg))}}

 @media(min-width:901px){.project:nth-child(even) .visual{grid-column:1;grid-row:1}.project:nth-child(even) .copy{grid-column:2;grid-row:1}}
 @media(max-width:900px){.project{grid-template-columns:1fr;gap:24px;min-height:0}.geometry-art{height:300px}}
 @media(max-width:600px){.project{padding:22px;border-radius:23px}}
</style>
