---
import AnimatedCover from "./AnimatedCover.astro";
interface Props{index:number;href:string}
const {index}=Astro.props;
---
<div class:list={["visual",`visual-${index}`]}>
 {index===0&&<div class="world-art" aria-hidden="true"><span>J.H. LAB</span><strong><span data-locale="zh">读一点<br/>世界。</span><span data-locale="en">WORLD<br/>IN FOCUS.</span></strong><small><span data-locale="zh">每天，从一个新问题开始</span><span data-locale="en">A new question, every day</span></small></div>}
 {index===1&&<AnimatedCover kind="mathematics" />}
 {index===2&&<AnimatedCover kind="memory" />}
 {index===3&&<AnimatedCover kind="geometry" />}
</div>
<style>
 .visual{min-height:380px;border:1px solid var(--stroke);border-radius:22px;overflow:hidden;background:linear-gradient(135deg,#e6ebf0,#f8f9fb);box-shadow:var(--shadow-sm);display:grid;place-items:center;position:relative}
 .world-art{padding:38px;display:flex;flex-direction:column;justify-content:space-between;width:82%;height:290px;background:rgba(255,255,255,.90);color:#1d1d1f;border:1px solid rgba(24,29,37,.11);box-shadow:var(--shadow-md)}
 .world-art>span,.world-art small{font:600 10px ui-monospace,monospace;letter-spacing:.1em}
 .world-art strong{font-size:clamp(37px,4vw,60px);line-height:1.15;letter-spacing:-.065em}
 @media(max-width:900px){.visual{min-height:300px}}
 @media(max-width:600px){.visual{min-height:245px}.world-art{height:210px;padding:23px}.world-art strong{font-size:36px}}
</style>
