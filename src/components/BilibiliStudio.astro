---
const profile="https://space.bilibili.com/1572685586";
const videos=[
 {id:"mobius",category:"几何极限",title:"莫比乌斯带最短能有多短？一张纸，逼出 √3 的几何极限",file:"/videos/Video_1792127365800_461.mp4",duration:"04:47",symbol:"√3",bvid:"BV1BDpB6wEiJ"},
 {id:"group",category:"群论入门",title:"第01讲｜群的定义与例子",file:"/videos/Video_1792127358357_245.mp4",duration:"03:24",symbol:"G",bvid:"BV1LTa562Ehz"}
];
---
<section class="bili-studio wrap" id="mathematics-video" aria-labelledby="bili-title">
 <div class="bili-intro">
  <div>
   <p class="eyebrow"><span data-locale="zh">数学影像 / 站内放映</span><span data-locale="en">MATHEMATICS / WATCH HERE</span></p>
   <h2 id="bili-title"><span data-locale="zh">让数学，在这里播放。</span><span data-locale="en">Watch mathematics in motion.</span></h2>
   <p><span data-locale="zh">两部原创数学视频，直接在 J.H. LAB 播放。无第三方播放器限制，支持全屏和进度控制。</span><span data-locale="en">Two original math videos, played right here with native video controls.</span></p>
  </div>
  <a class="bili-profile" href={profile} target="_blank" rel="noopener noreferrer"><span data-locale="zh">全部 B 站作品 ↗</span><span data-locale="en">All videos on Bilibili ↗</span></a>
 </div>
 <div class="bili-shell">
  <div class="bili-stage" data-bili-stage>
   <div class="bili-placeholder" data-bili-placeholder>
    <span class="bili-play-mark" aria-hidden="true">▶</span>
    <strong><span data-locale="zh">选择下方视频，开始观看</span><span data-locale="en">Choose a video to play</span></strong>
    <small><span data-locale="zh">点击后才加载视频，节省流量</span><span data-locale="en">Video loads only after selection</span></small>
   </div>
  </div>
  <div class="bili-playlist" aria-label="原创数学视频">
   {videos.map((v,index)=><button type="button" class="bili-video-card" data-bili-featured={v.id} data-local-src={v.file} data-bili-id={v.bvid} data-video-title={v.title} aria-label={`播放：${v.title}`} aria-pressed="false">
     <span class="bili-video-art" aria-hidden="true"><span class="bili-video-count">{String(index+1).padStart(2,"0")}</span><span class="bili-video-play">▶</span><span class="bili-video-symbol">{v.symbol}</span></span>
     <span class="bili-video-info"><small>{v.category} · {v.duration}</small><strong>{v.title}</strong><span class="bili-video-action"><span data-locale="zh">站内播放 ▶</span><span data-locale="en">Play here ▶</span></span></span>
   </button>)}
  </div>
  <div class="bili-controls">
   <p class="bili-status" data-bili-status role="status" aria-live="polite"><span data-locale="zh">选择视频后开始播放。如果视频尚未上传，会显示提示和备用链接。</span><span data-locale="en">Select a video to watch. Missing uploads are reported clearly.</span></p>
   <a class="bili-open" data-bili-open href={profile} target="_blank" rel="noopener noreferrer" hidden><span data-locale="zh">在 B 站观看此视频 ↗</span><span data-locale="en">Watch this video on Bilibili ↗</span></a>
  </div>
 </div>
</section>
<script>
 const stage=document.querySelector<HTMLElement>("[data-bili-stage]");
 const status=document.querySelector<HTMLElement>("[data-bili-status]");
 const originalLink=document.querySelector<HTMLAnchorElement>("[data-bili-open]");
 const say=(zh:string,en:string)=>{if(status)status.textContent=document.documentElement.lang==="en"?en:zh;};
 const play=async(button:HTMLButtonElement)=>{
  const src=button.dataset.localSrc||"";
  const bvid=button.dataset.biliId||"";
  if(!stage||!originalLink||!/^\/videos\/[a-z0-9-]+\.mp4$/.test(src))return;
  // Prevent a nonexistent upload from replacing the player with a broken video.
  const request=++activeRequest;
  say("正在准备站内视频…","Preparing on-site video…");
  originalLink.href="https://www.bilibili.com/video/"+encodeURIComponent(bvid);
  originalLink.hidden=false;
  try{
   const response=await fetch(src,{method:"HEAD",cache:"no-store"});
   if(request!==activeRequest)return;
   if(!response.ok||!response.headers.get("content-type")?.includes("video"))throw Error("asset unavailable");
  }catch{
   if(request!==activeRequest)return;
   say("原视频文件尚未部署到本站。请先上传 MP4；目前可通过备用链接在 B 站观看。","The original MP4 has not been deployed yet. Upload it first, or use the Bilibili link.");
   return;
  }
  const video=document.createElement("video");
  video.className="bili-native-video";
  video.controls=true;
  video.playsInline=true;
  video.preload="metadata";
  video.src=src;
  video.setAttribute("aria-label",button.dataset.videoTitle||"数学影像");
  video.addEventListener("error",()=>say("本站视频加载失败，可通过备用链接观看。","Video could not load. Use the original link."),{once:true});
  stage.replaceChildren(video);
  document.querySelectorAll<HTMLButtonElement>("[data-bili-featured]").forEach(item=>item.setAttribute("aria-pressed",String(item===button)));
  say("正在站内播放原始视频。","Playing the original video here.");
  void video.play().catch(()=>{say("请点击播放器中央的播放按钮开始观看。","Press play on the video to begin.");});
  stage.scrollIntoView({behavior:window.matchMedia("(prefers-reduced-motion: reduce)").matches?"instant":"smooth",block:"center"});
 };
 let activeRequest=0;
 document.querySelectorAll<HTMLButtonElement>("[data-bili-featured]").forEach(button=>button.addEventListener("click",()=>void play(button)));
</script>
<style>
 .bili-studio{padding-bottom:clamp(90px,10vw,145px);scroll-margin-top:100px}
 .bili-intro{display:flex;align-items:end;justify-content:space-between;gap:30px;margin:0 0 24px}
 .bili-intro h2{font-size:clamp(30px,4.8vw,60px);letter-spacing:-.06em;line-height:1.22;margin:12px 0 15px}
 .bili-intro p:last-child{max-width:680px;color:var(--muted);line-height:1.9;font-size:14px;margin-bottom:0}
 .bili-profile{color:var(--accent);font-size:13px;font-weight:700;white-space:nowrap;min-height:44px;display:inline-flex;align-items:center}
 .bili-shell{overflow:hidden;border:1px solid var(--stroke);border-radius:var(--radius);box-shadow:var(--shadow-md);background:var(--card)}
 .bili-stage{aspect-ratio:16/9;position:relative;width:100%;overflow:hidden;background:linear-gradient(140deg,#101e35,#263a53 54%,#0a111d)}
 .bili-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;text-align:center;color:#f5f7ff;padding:24px}
 .bili-placeholder strong{font-size:clamp(19px,2.1vw,29px);font-weight:650}
 .bili-placeholder small{font-size:12px;color:#c9d7ee}
 .bili-play-mark{display:grid;place-items:center;border:1px solid rgba(255,255,255,.45);border-radius:50%;width:74px;height:74px;background:rgba(255,255,255,.12);font-size:26px;padding-left:5px}
 .bili-stage :global(.bili-native-video){position:absolute;inset:0;width:100%;height:100%;background:#060a11}
 .bili-playlist{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;padding:clamp(16px,2.5vw,28px) clamp(16px,3vw,30px) 0}
 .bili-video-card{min-width:0;display:flex;align-items:stretch;gap:13px;text-align:left;color:var(--fg);background:var(--bg);border:1px solid var(--stroke);border-radius:18px;padding:10px;cursor:pointer;transition:border-color .25s ease,transform .25s ease,box-shadow .25s ease}
 .bili-video-card[aria-pressed="true"]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
 .bili-video-art{position:relative;flex:0 0 36%;min-height:110px;display:grid;place-items:center;overflow:hidden;border-radius:12px;background:radial-gradient(ellipse at 30% 35%,rgba(145,194,255,.35),transparent 68%),linear-gradient(140deg,#0f233e,#27446b);color:#fff}
 .bili-video-symbol{font-size:48px;opacity:.55;font-family:Georgia,serif}
 .bili-video-count{position:absolute;top:8px;left:10px;font-size:11px;letter-spacing:.1em;opacity:.8}
 .bili-video-play{position:absolute;bottom:9px;right:9px;display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:rgba(255,255,255,.22);font-size:11px;padding-left:2px}
 .bili-video-info{min-width:0;display:flex;flex-direction:column;gap:7px;padding:3px 1px}
 .bili-video-info small{font-size:11px;color:var(--muted)}
 .bili-video-info strong{font-size:clamp(13px,1.18vw,16px);line-height:1.55;font-weight:650}
 .bili-video-action{font-size:12px;color:var(--accent);font-weight:650;margin-top:auto}
 @media(hover:hover){.bili-video-card:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:var(--shadow-sm)}}
 @media(max-width:800px){.bili-playlist{grid-template-columns:1fr}}
 @media(max-width:500px){.bili-video-art{flex-basis:33%;min-height:120px}.bili-video-info strong{font-size:13px}}
 @media(prefers-reduced-motion:reduce){.bili-video-card{transition:none!important}}
 .bili-controls{padding:clamp(18px,3vw,30px);display:flex;flex-wrap:wrap;align-items:center;gap:12px;justify-content:space-between}
 .bili-status{font-size:12px;color:var(--muted);line-height:1.65;margin:0}
 .bili-open{font-size:13px;font-weight:650;color:var(--accent);white-space:nowrap}
 .bili-open[hidden]{display:none!important}
 @media(max-width:650px){.bili-intro{display:block}.bili-profile{margin-top:10px}.bili-shell{border-radius:22px}}
</style>
