---
import {navigation} from "../data/site";
---
<header class="glass-nav">
 <div class="nav-inner wrap">
  <a href="/" class="brand" aria-label="J.H. LAB 首页"><span aria-hidden="true"></span></a>
  <nav class="desktop-links" aria-label="Main navigation">
   {navigation.map(item=><a href={item.href}>
    <span data-locale="zh">{item.label.zh}</span><span data-locale="en">{item.label.en}</span>
   </a>)}
  </nav>
  <div class="controls">
   <button type="button" data-language-toggle aria-label="Switch to English">EN</button>
   <button type="button" data-theme-toggle aria-label="切换深浅色主题" title="切换主题"><span class="theme-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle class="sun-core" cx="12" cy="12" r="4.1"/><path class="sun-rays" d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/><path class="moon-shape" d="M20 14.2A8 8 0 0 1 9.8 4 8 8 0 1 0 20 14.2Z"/></svg></span></button>
   <button type="button" data-menu-toggle aria-controls="mobile-navigation" aria-expanded="false" aria-label="菜单"><span class="hamburger" aria-hidden="true"><i></i><i></i><i></i></span></button>
  </div>
 </div>
</header>
<div data-menu-backdrop class="menu-backdrop" hidden></div>
<nav id="mobile-navigation" data-menu-panel class="mobile-menu" aria-label="Mobile navigation" hidden>
 {navigation.map(item=><a href={item.href}>
  <span data-locale="zh">{item.label.zh}</span><span data-locale="en">{item.label.en}</span>
 </a>)}
</nav>
<style>
 .glass-nav{position:sticky;top:0;z-index:101;background:var(--glass);-webkit-backdrop-filter:blur(24px) saturate(165%);backdrop-filter:blur(24px) saturate(165%);border-bottom:1px solid var(--stroke);box-shadow:var(--shadow-sm)}
 .nav-inner{min-height:68px;display:grid;grid-template-columns:minmax(60px,1fr) auto minmax(125px,1fr);align-items:center;gap:clamp(14px,2vw,30px)}
 .brand{display:flex;align-items:center;min-width:44px;min-height:44px}
 .brand span{display:block;width:31px;height:30px;background:var(--fg);-webkit-mask:url("/assets/jh-orbit.svg") center/contain no-repeat;mask:url("/assets/jh-orbit.svg") center/contain no-repeat}
 .desktop-links{display:flex;justify-content:center;gap:clamp(20px,2.15vw,36px);white-space:nowrap}
 .desktop-links a{font-size:clamp(14px,1.02vw,16px);font-weight:600;opacity:.82;padding:12px 3px}
 .desktop-links a{position:relative;transition:opacity .24s ease,color .24s ease}
 .desktop-links a::after{content:"";position:absolute;height:2px;bottom:3px;left:2px;right:2px;border-radius:3px;background:var(--accent);transform:scaleX(0);transform-origin:center;opacity:.7;transition:transform .33s cubic-bezier(.16,1,.3,1)}
 .desktop-links a:hover{opacity:1}
 .desktop-links a:hover::after,.desktop-links a:focus-visible::after{transform:scaleX(1)}
 .controls{display:flex;justify-content:flex-end;gap:9px}
 .controls button{height:44px;min-width:44px;border:1px solid var(--stroke);border-radius:99px;background:transparent;color:var(--fg);font-size:13px}
 .controls button{transition:background-color .25s ease,border-color .25s ease,box-shadow .25s ease,transform .25s cubic-bezier(.16,1,.3,1)}
 @media(hover:hover){.controls button:hover{background:var(--card);border-color:var(--fg);box-shadow:var(--shadow-sm);transform:translateY(-1px)}}
 .controls button:active{transform:scale(.96)}
 .controls [data-language-toggle]{min-width:56px}
 .controls [data-theme-toggle]{display:grid;place-items:center}
 .theme-glyph{display:grid;place-items:center;width:24px;height:24px}
 .theme-glyph svg{width:24px;height:24px;overflow:visible;transition:transform .58s cubic-bezier(.2,.8,.2,1)}
 .sun-core,.sun-rays,.moon-shape{transform-origin:12px 12px;transition:opacity .42s ease,transform .58s cubic-bezier(.2,.8,.2,1)}
 .sun-core,.sun-rays{opacity:1;transform:scale(1)}
 .moon-shape{opacity:0;transform:scale(.58) rotate(-35deg)}
 :global(html[data-theme="dark"]) .sun-core,:global(html[data-theme="dark"]) .sun-rays{opacity:0;transform:scale(.55) rotate(45deg)}
 :global(html[data-theme="dark"]) .moon-shape{opacity:1;transform:scale(1) rotate(0)}
 :global(html[data-theme="dark"]) .theme-glyph svg{transform:rotate(-15deg)}

 .controls [data-menu-toggle]{display:none}
 .hamburger{display:flex;flex-direction:column;align-items:center;gap:4px}
 .hamburger i{display:block;width:17px;height:1.5px;border-radius:2px;background:currentColor}
 .menu-backdrop{position:fixed;inset:0;z-index:99;background:rgba(9,13,20,.25);-webkit-backdrop-filter:blur(5px) saturate(.78);backdrop-filter:blur(5px) saturate(.78)}
 .menu-backdrop:not([hidden]){animation:backdrop-enter .32s ease both}
 .mobile-menu{position:fixed;z-index:103;top:76px;right:12px;width:min(258px,calc(100vw - 46px));padding:9px 13px;border:1px solid rgba(255,255,255,.55);border-radius:27px;background:linear-gradient(145deg,rgba(255,255,255,.56),rgba(235,243,255,.24) 48%,rgba(255,255,255,.42));-webkit-backdrop-filter:blur(32px) saturate(185%) brightness(1.10);backdrop-filter:blur(32px) saturate(185%) brightness(1.10);box-shadow:0 22px 65px rgba(0,0,0,.22),inset 0 1.5px 1px rgba(255,255,255,.9),inset 1px 0 2px rgba(255,255,255,.5),inset 0 -2px 10px rgba(255,255,255,.18);isolation:isolate;overflow:hidden}
 .mobile-menu::before{content:"";position:absolute;inset:-35% -40%;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 24% 18%,rgba(255,255,255,.72),transparent 42%),radial-gradient(ellipse at 78% 80%,rgba(156,190,245,.26),transparent 48%);transform:rotate(-8deg);animation:liquid-sheen 5s ease-in-out infinite alternate}
 :global(html[data-theme="dark"]) .mobile-menu{background:linear-gradient(145deg,rgba(72,79,95,.56),rgba(30,36,49,.52) 52%,rgba(80,87,104,.39));border-color:rgba(255,255,255,.26);box-shadow:0 24px 66px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.28)}
 :global(html[data-theme="dark"]) .mobile-menu::before{opacity:.32}
 :global(html[data-menu-open="true"]) main,:global(html[data-menu-open="true"]) .site-footer{transform:scale(.955) translateY(10px);filter:blur(3px) brightness(.72);opacity:.82}
 :global(main),:global(.site-footer){transform-origin:center 15vh;transition:transform .48s cubic-bezier(.2,.78,.2,1),filter .48s ease,opacity .48s ease}
 .mobile-menu a{display:flex;align-items:center;justify-content:center;text-align:center;min-height:55px;border-bottom:1px solid rgba(105,115,132,.2);font-size:16px;font-weight:600;position:relative;z-index:1}
 .mobile-menu a:last-child{border-bottom:0}
 .mobile-menu:not([hidden]){animation:nav-panel-enter .28s cubic-bezier(.16,1,.3,1) both}
 .mobile-menu a{transition:background-color .22s ease,color .22s ease}
 .mobile-menu a:active{background:var(--stroke)}
 .hamburger i{transition:transform .24s ease,opacity .24s ease}
 [data-menu-toggle][aria-expanded="true"] .hamburger i:first-child{transform:translateY(5.5px) rotate(45deg)}
 [data-menu-toggle][aria-expanded="true"] .hamburger i:nth-child(2){opacity:0}
 [data-menu-toggle][aria-expanded="true"] .hamburger i:last-child{transform:translateY(-5.5px) rotate(-45deg)}
 @keyframes liquid-sheen{from{transform:translate(-3%,-2%) rotate(-8deg)}to{transform:translate(4%,3%) rotate(4deg)}}
 @keyframes backdrop-enter{from{opacity:0}to{opacity:1}}
 @keyframes nav-panel-enter{from{opacity:0;transform:translateY(-9px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
 @media(prefers-reduced-motion:reduce){:global(main),:global(.site-footer){transition:none!important}:global(html[data-menu-open="true"]) main,:global(html[data-menu-open="true"]) .site-footer{transform:none;filter:none}.mobile-menu::before{animation:none!important}.mobile-menu:not([hidden]),.menu-backdrop:not([hidden]){animation:none!important}.theme-glyph svg,.sun-core,.sun-rays,.moon-shape{transition:none!important}.controls button,.desktop-links a,.mobile-menu a,.hamburger i{transition:none!important}}
 [hidden]{display:none!important}
 @media(max-width:1180px){.nav-inner{grid-template-columns:1fr auto;min-height:50px}.desktop-links{display:none}.controls [data-menu-toggle]{display:flex;align-items:center;justify-content:center}}
 @media(max-width:760px){.nav-inner{min-height:56px}.brand span{width:27px;height:26px}.controls button{height:44px;min-width:44px}.mobile-menu{top:64px}}
</style>
