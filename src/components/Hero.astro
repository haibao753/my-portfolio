---
import SignatureMark from "./SignatureMark.astro";
import CuriositySculpture from "./CuriositySculpture.astro";
---
<section id="top" class="hero wrap">
 <div class="hero-copy">
 <h1 class="hero-title"><span data-locale="zh"><span class="hero-title-line">做一些有趣的</span><span class="hero-title-line">事情。</span></span><span data-locale="en"><span class="hero-title-line">Make something</span><span class="hero-title-line">interesting.</span></span></h1>
 <div class="actions">
  <a class="primary" href="#projects"><span data-locale="zh">探索作品 ↗</span><span data-locale="en">Explore Works ↗</span></a>
  <a class="secondary" href="/brief/"><span data-locale="zh">阅读每日简报 →</span><span data-locale="en">Daily Brief →</span></a>
 </div>
 <SignatureMark />
 </div>
 <CuriositySculpture />
</section>
<script>
 // Each glyph materializes on a deliberately non-linear signal clock.
 // The original HTML stays readable when scripts are disabled.
 const headline = document.querySelector<HTMLElement>(".hero-title");
 if (headline) {
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const chineseBeats = [0, 95, 175, 660, 740, 830, 1540, 1620, 2190];
  const englishSteps = [0, 75, 165, 260, 670, 755, 825, 910, 990, 1410, 1495, 1585, 1675, 2135, 2210, 2285, 2370, 2480, 2980, 3060, 3140, 3250, 3650, 3740, 3830, 3970];
  let currentLanguage = "";
  function render() {
   const language = document.documentElement.lang === "en" ? "en" : "zh";
   currentLanguage = language;
   headline.classList.remove("hero-title--pixels");
   headline.querySelectorAll<HTMLElement>(".hero-title-line").forEach(line => {
    const original = line.dataset.originalText ?? line.textContent ?? "";
    line.dataset.originalText = original;
    line.textContent = original;
   });
   headline.querySelectorAll<HTMLElement>("[data-locale]").forEach(group => group.removeAttribute("aria-label"));
   if (reducedMotion.matches) return;

   const active = headline.querySelector<HTMLElement>(`[data-locale="${language}"]`);
   if (!active) return;
   const lines = Array.from(active.querySelectorAll<HTMLElement>(".hero-title-line"));
   active.setAttribute("aria-label", lines.map(line => line.textContent ?? "").join(language === "zh" ? "" : " "));
   const beats = language === "zh" ? chineseBeats : englishSteps;
   let count = 0;
   for (const line of lines) {
    const fragment = document.createDocumentFragment();
    for (const character of Array.from(line.textContent ?? "")) {
     if (character === " ") {
      fragment.appendChild(document.createTextNode(" "));
      continue;
     }
     const glyph = document.createElement("span");
     glyph.className = "hero-title-glyph";
     glyph.setAttribute("aria-hidden", "true");
     glyph.dataset.glyph = character;
     const delay = beats[count] ?? beats[beats.length-1] + (count-beats.length+1)*110;
     glyph.style.setProperty("--glyph-delay", `${delay}ms`);
     // The occasional glint is a separate pseudo-element; final letters stay solid.
     if (count === 2 || count === 7 || count === 17) {
      glyph.dataset.glint = "";
      glyph.style.setProperty("--glint-delay", `${delay + 4600 + (count%3)*2100}ms`);
     }
     glyph.textContent = character;
     fragment.appendChild(glyph);
     count++;
    }
    line.replaceChildren(fragment);
   }
   // Reflow only once per run to reliably restart even after restoring from bfcache.
   void headline.offsetWidth;
   headline.classList.add("hero-title--pixels");
  }

  render();
  // Language changes are owned by BaseLayout, which updates html.lang directly.
  const observer = new MutationObserver(() => {
   const next = document.documentElement.lang === "en" ? "en" : "zh";
   if (next !== currentLanguage) render();
  });
  observer.observe(document.documentElement, {attributes:true,attributeFilter:["lang"]});
  reducedMotion.addEventListener("change", render);
  addEventListener("pageshow", event => { if (event.persisted) render(); });
 }
</script>
<style>
 .hero{display:grid;grid-template-columns:1fr 1.16fr;align-items:center;gap:clamp(10px,2vw,30px);text-align:left;padding-top:clamp(44px,6vw,76px);padding-bottom:clamp(80px,8vw,125px);position:relative;isolation:isolate}
 .hero-copy{min-width:0;position:relative;z-index:1}
 .hero h1{font-weight:750;letter-spacing:-.075em;line-height:1.14;font-size:clamp(53px,6.6vw,96px);margin:0 0 22px}
 /* Pixel-coded reveal: flicker, tiny stepped displacement, then perfectly legible text. */
 :global(.hero-title--pixels .hero-title-glyph){position:relative;display:inline-block;opacity:0;animation:hero-pixel-arrive 540ms steps(6,end) var(--glyph-delay) both}
 :global(.hero-title--pixels .hero-title-glyph::before){content:attr(data-glyph);position:absolute;inset:0;pointer-events:none;opacity:0;color:var(--accent);text-shadow:2px 0 #39d4eb,-2px 0 rgba(86,142,253,.7);clip-path:inset(15% 0 43% 0);animation:hero-pixel-ghost 540ms steps(5,end) var(--glyph-delay) both}
 :global(.hero-title--pixels .hero-title-glyph[data-glint]::after){content:attr(data-glyph);position:absolute;inset:0;pointer-events:none;color:var(--accent);opacity:0;clip-path:inset(42% 0 48% 0);animation:hero-pixel-glint 10s linear var(--glint-delay) infinite}
 @keyframes hero-pixel-arrive{0%{opacity:0;transform:translate3d(0,8px,0) scale(.92);text-shadow:3px 0 var(--accent),-3px 0 #45cbd8}17%{opacity:.9;transform:translate3d(2px,-2px,0) scale(1.025)}30%{opacity:.07;transform:translate3d(-2px,1px,0)}48%{opacity:1;transform:translate3d(1px,-1px,0);text-shadow:-2px 0 #48c8dc}61%{opacity:.2;transform:translate3d(0,2px,0)}81%{opacity:1;transform:none;text-shadow:1px 0 var(--accent)}100%{opacity:1;transform:none;text-shadow:none}}
 @keyframes hero-pixel-ghost{0%,12%,35%,63%,100%{opacity:0;transform:translateX(0)}18%,52%,77%{opacity:.8;transform:translateX(3px)}}
 @keyframes hero-pixel-glint{0%,1.5%,3%,100%{opacity:0}1.8%,2.2%{opacity:.65}2.5%{opacity:.16}}
 @media(prefers-reduced-motion:reduce){.hero-title--pixels .hero-title-glyph{animation:none!important;opacity:1;transform:none}.hero-title-glyph::before,.hero-title-glyph::after{display:none!important}}
 .hero-title-line{display:block;overflow:visible;white-space:nowrap}
 .hero-title [data-locale]{width:100%}
 .hero-title .hero-title-line:nth-child(2){margin-top:.018em}
 @media(max-width:500px){.hero-title{font-size:clamp(40px,10vw,56px)!important}.hero-title-line{white-space:normal}}
 .actions{display:flex;justify-content:flex-start;flex-wrap:wrap;gap:15px;margin-top:30px}
 .hero-copy :global(.signature-host){justify-content:flex-start;margin-top:32px}
 .hero-copy :global(.hero-autograph--pen){width:min(305px,90%)}
 .actions a{min-height:48px;border-radius:99px;padding:11px 24px;font-size:14px;display:inline-flex;align-items:center;justify-content:center;font-weight:600;transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease,background-color .25s ease}
 @media(hover:hover){.actions a:hover{transform:translateY(-3px)}.primary:hover{box-shadow:0 15px 32px rgba(5,103,222,.24)}.secondary:hover{background:var(--stroke)}}
 .actions a:active{transform:translateY(0) scale(.98)}
 @media(prefers-reduced-motion:reduce){.actions a{transition:none!important}.actions a:hover,.actions a:active{transform:none!important}}
 .primary{background:var(--accent);color:white;box-shadow:0 10px 23px rgba(5,103,222,.17)}
 .secondary{color:var(--accent)}
 html[data-theme="dark"] .signature{filter:invert(1)}
 @media(min-width:761px) and (max-width:1000px){.hero{grid-template-columns:1fr 1fr;gap:0}.hero h1{font-size:clamp(48px,6.7vw,68px)}.actions{gap:6px}.actions a{padding-inline:17px}}
 @media(max-width:760px){.hero{grid-template-columns:1fr;text-align:center;gap:14px;padding-top:38px;padding-bottom:80px}.hero-copy{display:contents}.hero h1{grid-row:1;font-size:clamp(46px,10vw,70px);margin-bottom:0}.hero :global(.sculpture-stage){grid-row:2}.actions{grid-row:3;justify-content:center;margin-top:0}.hero-copy :global(.signature-host){grid-row:4;justify-content:center;margin-top:12px}.hero-copy :global(.hero-autograph--pen){width:min(270px,85%)}}
</style>
