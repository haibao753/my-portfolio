---
import {Image} from "astro:assets";
import photo2 from "../../images/2.jpg";
import photo4 from "../../images/4.jpg";
import photo5 from "../../images/5.jpg";
interface Props{kind:"mathematics"|"memory"|"geometry"}
const {kind}=Astro.props;
---
{kind==="mathematics"&&<div class="animated-cover wave-cover math-art" data-animated-cover="mathematics" aria-hidden="true">
 <span class="cover-equation">eⁱᵗ = cos t + i sin t</span>
 <svg viewBox="0 0 450 300" focusable="false">
  <defs><linearGradient id="wave-ink"><stop stop-color="#315b9c"/><stop offset=".55" stop-color="#477dc4"/><stop offset="1" stop-color="#7aa8ce"/></linearGradient></defs>
  <g fill="none" stroke="currentColor" stroke-width=".65" opacity=".3"><path d="M25 152H427M145 44V256"/><circle cx="145" cy="152" r="63"/><circle cx="145" cy="152" r="34"/><path d="M50 88H420M50 216H420" stroke-dasharray="2 8"/></g>
  <g class="wave-arm" fill="none" stroke="url(#wave-ink)" stroke-width="1.4"><path d="M145 152L193 112L218 152"/><circle cx="193" cy="112" r="4" fill="#5e91c7"/><circle cx="193" cy="112" r="25" opacity=".48"/></g>
  <path d="M145 152L193 112L218 152C238 79 261 79 283 152S328 225 350 152S395 79 421 152" stroke="url(#wave-ink)" stroke-width="1" fill="none" opacity=".2"/>
  <path class="wave-trace" d="M145 152L193 112L218 152C238 79 261 79 283 152S328 225 350 152S395 79 421 152" stroke="url(#wave-ink)" stroke-width="2" fill="none" stroke-linecap="round"/>
  <g fill="currentColor" opacity=".4"><circle cx="145" cy="152" r="2"/><circle cx="82" cy="152" r="1.5"/><circle cx="145" cy="89" r="1.5"/></g>
 </svg>
 <span class="cover-caption"><span data-locale="zh">从一条线，看见一个想法</span><span data-locale="en">An idea, drawn into motion</span></span>
</div>}
{kind==="memory"&&<div class="animated-cover photo-art memory-cover" data-animated-cover="memory" aria-hidden="true">
 <div class="gallery-floor"></div>
 <div class="photo-room">{[photo2,photo4,photo5].map((photo,i)=><figure class:list={["photo-print",`print-${i}`]}><Image src={photo} data-portfolio-photo alt="" format="webp" quality={80} width={960} widths={[320,640,960]} sizes="(max-width: 600px) 30vw, (max-width: 900px) 24vw, 170px" loading="lazy" decoding="async" /></figure>)}</div>
 <span class="cover-caption"><span data-locale="zh">光影与记忆</span><span data-locale="en">Light and memory</span></span>
</div>}
{kind==="geometry"&&<div class="animated-cover orbital-cover geometry-art" data-animated-cover="geometry" aria-hidden="true">
 <svg viewBox="0 0 450 360" focusable="false">
  <defs>
   <linearGradient id="orbital-ink" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#6eabc6"/><stop offset=".3" stop-color="#c1deee"/><stop offset=".6" stop-color="#7896d3"/><stop offset="1" stop-color="#cabce0"/></linearGradient>
   <radialGradient id="orbital-metal" cx=".3" cy=".25"><stop stop-color="#fff"/><stop offset=".17" stop-color="#e1edf1"/><stop offset=".46" stop-color="#879eae"/><stop offset=".77" stop-color="#304654"/><stop offset="1" stop-color="#718e9b"/></radialGradient>
   <radialGradient id="orbital-halo"><stop stop-color="#6084ab" stop-opacity=".17"/><stop offset="1" stop-color="#6084ab" stop-opacity="0"/></radialGradient>
  </defs>
  <circle cx="225" cy="176" r="174" fill="url(#orbital-halo)"/>
  <path d="M44 176H405M225 42V312" stroke="#83a1b5" stroke-width=".5" opacity=".24"/>
  <g class="geometry-orbit" fill="none" stroke="url(#orbital-ink)" stroke-width="1.05">{Array.from({length:10},(_,i)=><ellipse cx="225" cy="176" rx="134" ry="61" transform={`rotate(${i*18} 225 176)`} opacity={.58+i%3*.1}/>)}</g>
  <circle class="orbit-track" cx="225" cy="176" r="151" stroke="#88a9c5" stroke-width=".65" stroke-dasharray="2 8" fill="none" opacity=".38"/>
  <g class="orbital-satellite"><circle cx="376" cy="176" r="8" fill="url(#orbital-metal)"/></g>
  <circle cx="225" cy="176" r="3" fill="#c1d7e8" opacity=".65"/>
 </svg>
 <span class="cover-caption"><span data-locale="zh">几何 · 交互实验</span><span data-locale="en">Geometry in motion</span></span>
</div>}
<script>
 import {initCoverMotion} from "../lib/cover-motion";
 initCoverMotion();
</script>
<style>
 .animated-cover{position:relative;isolation:isolate;min-width:0;width:100%;height:380px;overflow:hidden;--cover-play:paused}
 .animated-cover.is-cover-visible{--cover-play:running}
 .animated-cover svg{display:block;width:100%;height:100%}
 .cover-caption{position:absolute;bottom:22px;left:24px;right:24px;text-align:center;font-size:10px;letter-spacing:.12em;opacity:.7;color:var(--cover-ink);pointer-events:none}
 .wave-cover{color:var(--cover-ink);background:radial-gradient(ellipse at 42% 40%,rgba(255,255,255,.24),transparent 70%),var(--cover-paper)}
 .wave-cover::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(65,94,116,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(65,94,116,.055) 1px,transparent 1px);background-size:28px 28px;mask-image:radial-gradient(ellipse,black,transparent 73%);pointer-events:none}
 .cover-equation{position:absolute;top:25px;left:27px;font:italic 16px Georgia,serif;opacity:.64}
 .wave-trace{stroke-dasharray:760;animation:cover-trace 7s cubic-bezier(.45,0,.35,1) infinite;animation-play-state:var(--cover-play)}
 .wave-arm{transform-origin:145px 152px;animation:cover-arm 14s ease-in-out infinite alternate;animation-play-state:var(--cover-play)}
 .memory-cover{display:grid;place-items:center;background:linear-gradient(155deg,#e5e8e3,#dce2dc 65%,#d2dbd5);perspective:1000px}
 .gallery-floor{position:absolute;inset:72% -10% -10%;background:linear-gradient(#aebfb022,transparent);transform:rotateX(55deg);border-top:1px solid #879c881f}
 .photo-room{width:86%;height:71%;display:grid;grid-template-columns:1fr 1.1fr 1fr;align-items:center;gap:11px;transform-style:preserve-3d;animation:cover-room 21s ease-in-out infinite alternate;animation-play-state:var(--cover-play)}
 .photo-print{height:87%;min-width:0;margin:0;padding:7px;background:#fafbf7;border:1px solid #cad1c8;box-shadow:9px 13px 19px #233c3226,inset 0 1px #fff;transform:rotate(-3deg) translateY(8px)}
 .photo-print img{display:block;width:100%;height:100%;object-fit:cover;min-width:0}
 .photo-print:nth-child(2){height:100%;transform:translateZ(16px) rotate(1deg)}
 .photo-print:last-child{transform:rotate(3deg) translateY(-5px)}
 .memory-cover .cover-caption{color:#506555}
 .orbital-cover{background:radial-gradient(ellipse at 30% 20%,#2a4459,#152b3d 72%);color:#bdd4e5}
 .orbital-cover::after{content:"";position:absolute;inset:0;box-shadow:inset 0 1px rgba(233,244,255,.18);pointer-events:none}
 .orbital-cover .cover-caption{color:#c1d5e3}
 .geometry-orbit{transform-origin:225px 176px;animation:cover-orbit 19s ease-in-out infinite alternate;animation-play-state:var(--cover-play)}
 .orbital-satellite{transform-origin:225px 176px;animation:cover-satellite 32s linear infinite;animation-play-state:var(--cover-play)}
 .orbit-track{animation:cover-track 28s linear infinite;animation-play-state:var(--cover-play)}
 :global(html[data-theme="dark"]) .memory-cover{background:linear-gradient(150deg,#34473d,#24382e)}
 :global(html[data-theme="dark"]) .memory-cover .cover-caption{color:#c8d8ca}
 :global(html[data-theme="dark"]) .photo-print{background:#d9ded5;border-color:#a5b5a8;box-shadow:9px 13px 20px #0004}
 @keyframes cover-trace{0%{stroke-dashoffset:760}48%,72%{stroke-dashoffset:0}100%{stroke-dashoffset:-760}}
 @keyframes cover-arm{from{transform:rotate(-9deg)}to{transform:rotate(11deg)}}
 @keyframes cover-room{from{transform:rotateY(-9deg) rotateX(2deg) translateY(2px)}to{transform:rotateY(7deg) rotateX(-1deg) translateY(-3px)}}
 @keyframes cover-orbit{from{transform:rotate(-9deg) scale(.94)}to{transform:rotate(12deg) scale(1.035)}}
 @keyframes cover-satellite{to{transform:rotate(360deg)}}
 @keyframes cover-track{to{stroke-dashoffset:-100}}
 @media(max-width:900px){.animated-cover{height:300px}}
 @media(max-width:600px){.animated-cover{height:245px}.cover-caption{bottom:16px;font-size:9px}.cover-equation{top:17px;left:20px;font-size:13px}.photo-room{gap:7px;width:87%;height:69%}.photo-print{padding:5px}}
 @media(prefers-reduced-motion:reduce){.geometry-orbit,.orbital-satellite,.orbit-track,.wave-trace,.wave-arm,.photo-room{animation:none!important}}
</style>
