---
import {projects} from '../data/site';
const experiment=projects.find(project=>project.id==='experiments')!;
---
<section class="universe" id="top" data-optical-universe aria-labelledby="universe-title">
 <div class="universe-plate" data-universe-stage>
  <canvas data-universe-plate aria-hidden="true"></canvas>
  <div class="orbital-mark orbit-a" aria-hidden="true"></div><div class="orbital-mark orbit-b" aria-hidden="true"></div>
  <span class="field-index" aria-hidden="true">A SMALL CORNER OF AN INFINITE UNIVERSE</span>
  <header class="universe-copy">
   <p class="world-eyebrow"><i></i><span data-locale="zh">个人作品集 / 数学 · 代码 · 影像</span><span data-locale="en">PERSONAL PORTFOLIO / MATH · CODE · IMAGES</span></p>
   <h1 id="universe-title"><span data-locale="zh">你好，我是<br/><em>Hu Jinhai</em><span class="site-introduction">的个人网站</span></span><span data-locale="en">Hi, this is<br/><em>Hu Jinhai’s</em><span class="site-introduction">personal website</span></span></h1>
   <p class="world-intro"><span data-locale="zh">我用代码制作数学动画和交互实验，<br/>也用照片收藏日常的光影。</span><span data-locale="en">I make mathematical animations and interactive experiments.<br/>I also collect everyday light through photography.</span></p>
   <div class="hero-actions"><a class="enter-world primary-entry" href="#worlds"><span data-locale="zh">看我的作品</span><span data-locale="en">View my work</span><b aria-hidden="true">↓</b></a><a class="enter-world experiment-entry" href={experiment.href}><span data-locale="zh">先玩一个实验</span><span data-locale="en">Try an experiment</span><b aria-hidden="true">↗</b></a></div>
  </header>
  <div class="sculpture" data-sculpture-frame>
   <div class="sculpture-fallback" data-sculpture-fallback aria-hidden="true"><i></i><i></i></div>
   <canvas data-sculpture-canvas aria-hidden="true"></canvas>
   <button type="button" class="sculpture-touch" data-sculpture-touch aria-label="点击玻璃，改变形态 / Click the glass to change its form"><span class="touch-cross" aria-hidden="true">✳</span><span class="touch-caption"><span data-locale="zh">点击变形</span><span data-locale="en">CLICK TO RESHAPE</span></span></button>
  </div>
  <div class="sculpture-caption"><span data-locale="zh">这个光学实验可以玩</span><span data-locale="en">AN OPTICAL EXPERIMENT YOU CAN PLAY</span><span data-locale="zh">移动鼠标，改变视角。<br/>点击玻璃，让它变形。</span><span data-locale="en">Move your mouse to change the view.<br/>Click the glass to reshape it.</span><i aria-hidden="true">↖</i></div>
  <span class="oversized-word" aria-hidden="true">CURIOSITY</span>
  <footer class="world-dock">
   <div class="world-selector" role="group" aria-label="雕塑灯光 / Sculpture lighting">
    <span class="lighting-label"><span data-locale="zh">换个光色</span><span data-locale="en">LIGHTING</span></span>
    <button type="button" data-universe-mode="0" aria-pressed="true"><span class="mode-dot"></span><span>01</span><span data-locale="zh">蓝色</span><span data-locale="en">BLUE</span></button>
    <button type="button" data-universe-mode="1" aria-pressed="false"><span class="mode-dot"></span><span>02</span><span data-locale="zh">紫色</span><span data-locale="en">VIOLET</span></button>
    <button type="button" data-universe-mode="2" aria-pressed="false"><span class="mode-dot"></span><span>03</span><span data-locale="zh">绿色</span><span data-locale="en">GREEN</span></button>
   </div>
   <div class="world-tools"><button type="button" data-universe-pause aria-pressed="false"><span data-universe-pause-label>暂停动画</span><span aria-hidden="true">Ⅱ</span></button><a href="#worlds"><span data-locale="zh">向下看作品</span><span data-locale="en">SCROLL FOR MY WORK</span><span aria-hidden="true">↓</span></a></div>
  </footer>
  <p class="world-feedback" data-universe-feedback role="status" aria-live="polite"></p>
 </div>
</section>
<script is:inline type="module" src="/assets/optical-universe.js"></script>
<style>
 .universe{position:relative;color:#f2f1eb;background:#0a0b10;overflow:clip;--world-accent:#dcff8b;--world-line:rgba(231,235,244,.18)}
 .universe-plate{position:relative;min-height:820px;height:100svh;max-height:1200px;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 76% 40%,#23304366,transparent 55%),#0a0b10}
 [data-universe-plate]{position:absolute;inset:0;width:100%;height:100%;z-index:-2}.universe-copy{position:relative;margin-left:7%;padding-top:clamp(160px,20vh,230px);width:54%;z-index:3;pointer-events:none}.universe-copy a{pointer-events:auto}
 .world-eyebrow{display:flex;align-items:center;gap:12px;font:10px/1.5 ui-monospace,monospace;letter-spacing:.12em;color:#bbbfc6;margin-bottom:37px}.world-eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--world-accent);box-shadow:0 0 15px #d5ff9c66}
 h1{font-size:clamp(76px,8.3vw,144px);font-weight:550;line-height:1.11;letter-spacing:-.075em;margin-bottom:28px}h1 em{font-family:Georgia,'Songti SC','SimSun',serif;font-weight:400;font-style:italic;color:var(--world-accent);padding-left:.68em;letter-spacing:-.08em}
 :global(html[lang="en"]) h1{font-size:clamp(76px,8.2vw,142px);line-height:.98;letter-spacing:-.07em}:global(html[lang="en"]) h1 em{padding-left:.10em}
 h1 em{word-spacing:.14em}.site-introduction{display:block;margin-top:.5em;font:400 clamp(18px,1.8vw,26px)/1.4 ui-sans-serif,sans-serif;letter-spacing:.04em;color:#bbbfc6}
 .world-intro{font-size:14px;line-height:1.9;color:#b6b9c3;letter-spacing:.02em;margin:29px 0 24px}.hero-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.enter-world{display:inline-flex;gap:26px;align-items:center;font-size:12px;color:#e7e8e8;min-height:48px;border-bottom:1px solid #7c808c;padding-bottom:5px}.primary-entry{background:var(--world-accent);color:#10160d;border-color:transparent;border-radius:28px;padding:8px 21px;gap:24px}.enter-world b{font-size:26px;font-weight:400;transition:transform .3s}.enter-world:hover b{transform:translate(3px,-3px)}.primary-entry:hover b{transform:translateY(3px)}
 .sculpture{position:absolute;width:min(66vw,1040px);height:90%;right:-6%;top:4%;z-index:2}.sculpture>canvas{position:absolute;width:100%;height:100%;inset:0;filter:drop-shadow(0 38px 36px #0006)}.sculpture-touch{position:absolute;inset:15%;border:0;background:none;border-radius:50%;color:#fff;touch-action:pan-y;cursor:crosshair}.touch-cross{position:absolute;font-size:44px;left:53%;top:55%;opacity:0;transition:opacity .3s,transform .5s}.touch-caption{position:absolute;top:68%;left:40%;font:8px ui-monospace,monospace;letter-spacing:.13em;opacity:0;transition:opacity .3s}.sculpture-touch:hover .touch-cross,.sculpture-touch:focus-visible .touch-cross,.sculpture-touch:hover .touch-caption,.sculpture-touch:focus-visible .touch-caption{opacity:1}.sculpture-touch:hover .touch-cross{transform:rotate(90deg)}
 .sculpture-fallback{position:absolute;inset:22%;transform:rotate(-30deg)}.sculpture-fallback i{display:block;position:absolute;inset:0;border:45px solid #aab6ca;border-radius:50%;background:transparent;box-shadow:inset 8px 4px 20px #fff9,12px 13px 50px #0008,-10px -6px 20px #eff3ff88;transform:rotateY(38deg)}.sculpture-fallback i+ i{transform:rotateY(-42deg) rotateX(55deg);border-color:#6a719f;inset:4%}
 [data-universe-gpu="true"] .sculpture-fallback{display:none}.sculpture-caption{position:absolute;right:5%;bottom:21%;width:235px;z-index:4;display:grid;gap:8px;font:11px/1.7 ui-sans-serif,sans-serif;letter-spacing:.02em;color:#b0b8c5;text-shadow:0 1px 8px #000;pointer-events:none}.sculpture-caption>span:first-child,.sculpture-caption>span:nth-child(2){color:var(--world-accent)}.sculpture-caption i{position:absolute;font-style:normal;font-size:31px;left:-45px;top:-8px}
 .oversized-word{position:absolute;bottom:69px;left:4%;font-size:clamp(90px,17.3vw,310px);font-weight:650;letter-spacing:-.085em;line-height:1;color:transparent;-webkit-text-stroke:1px #f6f8ff14;pointer-events:none;z-index:-1}.field-index{position:absolute;top:145px;right:5%;font:8px ui-monospace,monospace;letter-spacing:.16em;writing-mode:vertical-rl;color:#737d8f;z-index:1}.orbital-mark{position:absolute;border:1px solid #aec7ee0c;border-radius:50%;width:64vw;height:64vw;right:-4vw;top:-10vw;pointer-events:none;transform:rotate(-30deg) scaleY(.74);z-index:-1}.orbit-b{right:-6vw;transform:rotate(35deg) scaleY(.75)}
 .world-dock{position:absolute;bottom:28px;left:5%;right:5%;border-top:1px solid var(--world-line);padding-top:20px;display:flex;justify-content:space-between;gap:24px;z-index:5}.world-selector{display:flex;gap:7px}.world-selector button{display:flex;align-items:center;gap:9px;min-height:44px;padding:9px 15px;background:transparent;border:1px solid transparent;border-radius:30px;font:10px ui-monospace,monospace;color:#8d94a4;transition:color .3s,border-color .3s,background .3s}.world-selector button>span:nth-child(2){opacity:.45;font-size:8px}.world-selector button[aria-pressed="true"]{border-color:#8e99ac42;color:#f1f4ef;background:#e7ecff09}.mode-dot{width:6px;height:6px;border-radius:50%;background:#7c92c2}.world-selector button[data-universe-mode="1"] .mode-dot{background:#d994eb}.world-selector button[data-universe-mode="2"] .mode-dot{background:#c9ef8b}.world-selector button[aria-pressed="true"] .mode-dot{box-shadow:0 0 10px currentColor}.world-tools{display:flex;align-items:center;gap:30px}.world-tools button,.world-tools a{display:flex;align-items:center;gap:16px;min-height:44px;background:none;border:0;color:#a3aab8;font:9px ui-monospace,monospace;letter-spacing:.04em}.world-tools a>span:last-child{font-size:23px;color:#e0e6ee}.world-feedback{position:absolute;bottom:91px;left:5%;font:10px ui-monospace,monospace;color:var(--world-accent);z-index:5;pointer-events:none;margin:0;min-height:16px}
 [data-universe-mode="1"].universe{--world-accent:#e8b0ff}[data-universe-mode="2"].universe{--world-accent:#c9ff80}
 .lighting-label{display:flex;align-items:center;color:#a3aab8;font:10px ui-monospace,monospace;margin-right:8px}
 @media(min-width:1800px){.universe-copy{margin-left:10%}.sculpture{right:0}}
 @media(max-width:1000px){.universe-copy{margin-left:6%;width:60%}h1{font-size:clamp(68px,10vw,102px)}.sculpture{width:78vw;right:-19%;top:12%;height:78%}.sculpture-caption{right:5%;bottom:22%;width:120px;font-size:7px}.world-tools>a{display:none}.world-tools{gap:10px}.world-selector button{padding:8px 10px;gap:6px}}
 @media(max-width:760px){.universe-plate{height:960px;min-height:940px;max-height:none}.universe-copy{padding-top:125px;margin-left:7%;width:87%}.world-eyebrow{font-size:8px;letter-spacing:.09em;margin-bottom:23px}h1{font-size:clamp(62px,17vw,108px);line-height:1.1;margin-bottom:20px}h1 em{padding-left:1.4em}.world-intro{font-size:11px;line-height:1.8;width:68%;margin-top:21px}.enter-world{font-size:10px;gap:22px;min-height:44px}.enter-world b{font-size:23px}.sculpture{width:120%;height:54%;right:-17%;top:37%}.sculpture-touch{inset:17% 21%}.touch-cross{opacity:.6;font-size:28px;left:53%;top:64%}.touch-caption{display:none}.sculpture-caption{right:8%;bottom:18%;font-size:6px;width:93px;gap:6px}.sculpture-caption i{left:-27px;font-size:22px}.field-index{top:178px;right:5%;font-size:6px}.oversized-word{font-size:20vw;bottom:166px;left:4%;-webkit-text-stroke-color:#ffffff17}.world-dock{bottom:19px;left:6%;right:6%;padding-top:14px;display:block}.world-selector{justify-content:space-between;gap:2px}.world-selector button{padding:7px 10px;font-size:9px;gap:6px}.world-selector button>span:nth-child(2){display:none}.world-tools{margin-top:10px;justify-content:space-between}.world-tools button,.world-tools a{font-size:8px;min-height:38px}.world-tools>a{display:flex}.world-tools a>span:last-child{font-size:19px}.world-feedback{bottom:135px;left:7%;font-size:8px}.orbital-mark{width:160vw;height:160vw;right:-60vw;top:20%}:global(html[lang="en"]) h1{font-size:clamp(59px,16vw,105px)}:global(html[lang="en"]) h1 em{padding-left:.10em}}
 @media(prefers-reduced-motion:reduce){.enter-world b,.touch-cross,.touch-caption,.world-selector button{transition:none}}
 @media(max-width:1000px){.sculpture-caption{width:190px;font-size:10px}.hero-actions{gap:18px}}
 @media(max-width:760px){h1{font-size:clamp(48px,15vw,88px)}h1 em{padding-left:.7em}.world-intro{font-size:12px;width:92%;margin-top:22px}.hero-actions{gap:16px}.enter-world{font-size:11px;min-height:44px;gap:14px}.primary-entry{padding:7px 17px;gap:17px}.sculpture-caption{width:165px;font-size:9px;right:7%;bottom:17%;gap:5px}.sculpture-caption i{font-size:23px;left:-30px}.lighting-label{font-size:9px;margin-right:3px}.world-selector button{font-size:10px}.world-tools button,.world-tools a{font-size:9px}:global(html[lang="en"]) h1{font-size:clamp(48px,14.5vw,84px)}}
</style>
